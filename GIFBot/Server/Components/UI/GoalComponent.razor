@using global::GIFBot.Shared.Models.Features

<MudDialog @bind-Visible="@mIsAddMilestoneVisible">
   <TitleContent>
      <MudText Typo="Typo.h6">Add Milestone</MudText>
   </TitleContent>
   <DialogContent>
      <MudNumericField T="int" Label="Percentage Trigger Point" Min="1" Max="100" @bind-Value="mNewMilestonePercentage" />
      <MudTextField T="string" Label="Animation Command" @bind-Value="mNewMilestoneCommand" Class="mt-2" />
   </DialogContent>
   <DialogActions>
      <MudButton OnClick="@HandleCancelAddMilestone">Cancel</MudButton>
      <MudButton Color="Color.Primary" OnClick="@HandleAddMilestone">Add</MudButton>
   </DialogActions>
</MudDialog>

<div>
   <div class="d-flex justify-end gap-2 mb-3">
      @if (!mGoal.IsActive)
      {
         <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@HandleSetAsActiveGoal">Set As Active Goal</MudButton>
      }
      <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@HandleDeleteGoal">Delete</MudButton>
   </div>
   <div class="form-group">
      <label for="uiGoalTitleLabel">Title of Goal:</label>
      <span id="uiGoalTitleLabel" class="gifbot-field-desc">The purpose of your goal (ex: "New Camera" or "Sweet Mic").</span>
      <MudTextField T="string" @bind-Value="mGoal.Title" />
   </div>
   <div class="form-group">
      <label for="uiGoalAmountLabel">Goal Amount:</label>
      <span id="uiGoalAmountLabel" class="gifbot-field-desc">The total amount for the ultimate goal.</span>
      <DataAnnotationsValidator />
      <ValidationSummary />
      <MudNumericField T="double" Min="1" Max="1000000" @bind-Value="mGoal.GoalAmount" />
   </div>
   <div class="form-group">
      <label for="uiGoalCurrentAmountLabel">Current Amount:</label>
      <span id="uiGoalCurrentAmountLabel" class="gifbot-field-desc">The <i>current</i> amount raised toward the goal.</span>
      <DataAnnotationsValidator />
      <ValidationSummary />
      <MudNumericField T="double" Min="0" Max="1000000" @bind-Value="mGoal.CurrentAmount" />
   </div>
   <div class="form-group form-check">
      <MudCheckBox T="bool" @bind-Value="mGoal.ResetWhenComplete" Label="Reset the goal when completed." />
      <span id="uiResetWhenComplete" class="gifbot-field-desc">When enabled, the goal will reset back to 0 after the goal amount is reached. Note that doing this means that any additional goals in the chain after this one will not be activated.</span>
   </div>

   <MudExpansionPanel Text="Milestones" Style="font-weight: bold; font-size: 1rem;" Expanded="true">
      <div class="form-group">
         <MudDataGrid T="GoalMilestone" Items="@mGoal.Milestones" SortMode="SortMode.Single">
            <ToolBarContent>
               <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => { mIsAddMilestoneVisible = true; })">Add Milestone</MudButton>
            </ToolBarContent>
            <Columns>
               <PropertyColumn T="GoalMilestone" TProperty="int" Property="@(x => x.PercentageTriggerPoint)" Title="Percentage Trigger Point" />
               <PropertyColumn T="GoalMilestone" TProperty="string" Property="@(x => x.AnimationCommand)" Title="Animation Command to Fire" />
               <TemplateColumn>
   <CellTemplate Context="subcontext">
                  <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => DeleteMilestoneHandler(subcontext.Item))" />
                  </CellTemplate>
</TemplateColumn>
            </Columns>
         </MudDataGrid>
      </div>
   </MudExpansionPanel>
</div>

@code {

   [Parameter]
   public GoalData Goal
   {
      get { return mGoal; }
      set
      {
         mGoal = value;
         StateHasChanged();
      }
   }

   /// <summary>
   /// Event fired when the user tries set a goal as active.
   /// </summary>
   [Parameter]
   public EventCallback<Guid> OnMakeGoalActive { get; set; }

   /// <summary>
   /// Event fired when the user deletes a goal.
   /// </summary>
   [Parameter]
   public EventCallback<Guid> OnDeleteGoal { get; set; }

   private void HandleSetAsActiveGoal()
   {
      OnMakeGoalActive.InvokeAsync(mGoal.Id);
   }

   private void HandleDeleteGoal()
   {
      OnDeleteGoal.InvokeAsync(mGoal.Id);
   }

   private void UpdateMilestoneHandler(EventArgs args)
   {
      StateHasChanged();
   }

   private void DeleteMilestoneHandler(GoalMilestone milestone)
   {
      mGoal.Milestones.Remove(milestone);
      StateHasChanged();
   }

   private void AddMilestoneHandler(GoalMilestone milestone)
   {
      mGoal.Milestones.Add(milestone);
      mGoal.Milestones = mGoal.Milestones.OrderBy(m => m.PercentageTriggerPoint).ToList();
      StateHasChanged();
   }

   private GoalData mGoal = new GoalData();

   private bool mIsAddMilestoneVisible = false;
   private int mNewMilestonePercentage = 50;
   private string mNewMilestoneCommand = string.Empty;

   private void HandleAddMilestone()
   {
      if (string.IsNullOrWhiteSpace(mNewMilestoneCommand))
         return;
      
      var milestone = new GoalMilestone
      {
         PercentageTriggerPoint = mNewMilestonePercentage,
         AnimationCommand = mNewMilestoneCommand
      };
      AddMilestoneHandler(milestone);
      mIsAddMilestoneVisible = false;
      mNewMilestonePercentage = 50;
      mNewMilestoneCommand = string.Empty;
   }

   private void HandleCancelAddMilestone()
   {
      mIsAddMilestoneVisible = false;
      mNewMilestonePercentage = 50;
      mNewMilestoneCommand = string.Empty;
   }

}
