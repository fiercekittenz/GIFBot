@using global::GIFBot.Shared
@using global::GIFBot.Shared.Models.Animation
@using global::GIFBot.Shared.Models.Visualization
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject HttpClient Http

<EditForm Model="@mData" OnSubmit="@HandleSave">
   <div class="p-2 mb-2 rounded gifbot-content-panel">
      <div class="text-left" style="width: 100%">
         <MudButton Variant="Variant.Filled" Class="p-1 gifbot-special-btn" Style="margin-left: auto; margin-right: 0" OnClick="@OnTestAnimation">Test Animation</MudButton>
         <MudButton Variant="Variant.Filled" Class="p-1 gifbot-secondary-btn" Style="margin-left: auto; margin-right: 0" OnClick="@OnChangeCategory">Change Category</MudButton>
         <MudButton Variant="Variant.Filled" Class="p-1 gifbot-secondary-btn" Style="margin-left: auto; margin-right: 0" OnClick="@OnCloneAnimation">Clone</MudButton>
         <MudButton Variant="Variant.Filled" Class="p-1 gifbot-danger-btn" Style="margin-left: auto; margin-right: 0" OnClick="@OnDeleteAnimation">Delete</MudButton>
         <MudButton Variant="Variant.Filled" Class="p-1 gifbot-secondary-btn" ButtonType="ButtonType.Reset" OnClick="@OnCancel">Cancel</MudButton>
         <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="p-1" ButtonType="ButtonType.Submit">Save Changes</MudButton>
      </div>
   </div>
   <MudTabs @bind-ActivePanelIndex="@ActiveTabIndex" ApplyEffectsToContainer="true" Elevation="0" Rounded="true" PanelClass="pa-3">
      <MudTabPanel Text="General">
         <div class="p-0 m-0 rounded gifbot-section-panel">
            <div class="p-2">
               <div class="mt-2">
                  <MudCheckBox T="bool" @bind-Value="mData.Disabled" Label="Disabled" />
                  <small for="uiDisabled" class="form-text text-white-50 ml-4">When disabled, an animation can only be triggered by the broadcaster.</small>
               </div>
               <div class="mt-2">
                  <MudCheckBox T="bool" @bind-Value="mData.HideFromChatOutput" Label="Hide from !animations Output" />
                  <small id="uiHideFromChat" class="form-text text-white-50 ml-4">When enabled, the command will not appear in the list of chat output on the !animations command.</small>
               </div>
               <div class="mt-2">
                  <label for="uiCommand"><b>Command (Name):</b></label>
                  <small id="uiCommand" class="form-text text-white-50">The command viewers have to use in chat to trigger this animation. If your animation has special trigger requirements (sub, resub, tip, etc.) then this is just its name.</small>
                  <MudTextField T="string" @bind-Value="mData.Command" />
               </div>

               <MudExpansionPanel Text="Audio/Visual" Expanded="true">
                  <table>
                     <tr>
                        <td style="width: 45%" valign="top">
                           <div class="form-group">
                              <label for="uiVisual"><b>Visual:</b></label>
                              <small id="uiVisual" class="form-text text-white-50">The visual file played with this command.</small>
                              <table>
                                 <tr>
                                    <td valign="top">
                                       <MudTextField T="string" Disabled="true" @bind-Value="mData.Visual" />
                                       @* TODO: Wire up file upload handler *@
<InputFile accept="image/gif,image/jpeg,image/png,video/mp4,video/webm,video/mov" style="width: 100%; background-color: #16162e" />
                                       @if (mUploadVisualProgress > 0)
                                       {
                                           <MudProgressLinear Value="@mUploadVisualProgress" Style="margin-bottom: 20px; width: 100%" />
                                       }
                                       @if (!String.IsNullOrEmpty(mUploadVisualErrorMessage))
                                       {
                                          <label class="text-danger">@mUploadVisualErrorMessage</label>
                                       }
                                    </td>
                                    <td style="text-align: left; vertical-align: top"><MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Class="p-0 m-0 gifbot-secondary-btn" OnClick="@ClearVisualFile" Title="Clear Visual" /></td>
                                 </tr>
                              </table>
                           </div>
                        </td>
                        <td style="width: 10%"></td>
                        <td style="width: 45%" valign="top">
                           <div class="form-group">
                              <label for="uiAudio"><b>Audio:</b></label>
                              <small id="uiAudio" class="form-text text-white-50">The audio file played with this command.</small>
                              <table>
                                 <tr>
                                    <td valign="top">
                                       <MudTextField T="string" Disabled="true" @bind-Value="mData.Audio" />
                                       @* TODO: Wire up file upload handler *@
<InputFile accept="audio/*" style="width: 100%; background-color: #16162e" />
                                       @if (mUploadAudioProgress > 0)
                                       {
                                           <MudProgressLinear Value="@mUploadAudioProgress" Style="margin-bottom: 20px; width: 100%" />
                                       }
                                       @if (!String.IsNullOrEmpty(mUploadAudioErrorMessage))
                                       {
                                          <label class="text-danger">@mUploadAudioErrorMessage</label>
                                       }
                                    </td>
                                    <td style="width: 30px; text-align: center; vertical-align: top"><MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Class="p-0 m-0 gifbot-secondary-btn" OnClick="@ClearAudioFile" Title="Clear Audio" /></td>
                                 </tr>
                              </table>
                           </div>
                        </td>
                     </tr>
                  </table>
                  @if (!String.IsNullOrEmpty(mData.Audio) || AnimationLibrary.GetFileTypeOfAnimation(mData.Visual) == AnimationEnums.FileType.Video)
                  {
                     <div class="form-group">
                        <label for="uiVolumeSlider" class="ml-2 mt-2"><b>Volume:</b></label>
                        <center><input type="range" class="slider" min="0" max="100" value="@mFormVolume" id="uiVolumeSlider" @onchange="@(args => OnVolumeChanged(args))"></center>
                        <p align="right">
                           @if (!String.IsNullOrEmpty(mData.Audio))
                           {
                               <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="p-1 mr-2 mb-2 text-center gifbot-action-btn" Style="width: 200px" OnClick="@HandleTestAudioVolume">
                                  Test Audio File Volume
                               </MudButton>
                           }
                           else if (!String.IsNullOrEmpty(mData.Visual) && AnimationLibrary.GetFileTypeOfAnimation(mData.Visual) == AnimationEnums.FileType.Video)
                           {
                               <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="p-1 mr-2 mb-2 mt-2 text-center gifbot-action-btn" Style="width: 200px" OnClick="@HandleTestVideoVolume">
                                  Test Video File Volume
                               </MudButton>
                               <MudIconButton Icon="@Icons.Material.Filled.Stop" Size="Size.Small" Color="Color.Primary" Class="p-1 mr-2 mb-2 mt-2 text-center gifbot-action-btn" OnClick="@HandleStopTestVideoVolume" Title="Stop Video" />
                              <video id="videoAnimationAudioPreview" width="0" height="0" style="position:absolute;top:0;left:0;visibility: hidden;background-color: transparent">
                                 <source src="">
                              </video>
                           }
                        </p>
                     </div>
                  }
               </MudExpansionPanel>

               <MudExpansionPanel Text="Timing" Expanded="true">
                  <div class="form-group">
                     <label for="uiDuration"><b>Duration (in milliseconds):</b></label>
                     <small id="uiDuration" class="form-text text-white-50">The number of milliseconds this animation should play for (<i>Math Reminder: 1 second = 1000ms</i>).</small>
                     <MudNumericField T="int" Min="1000" Max="9999999" @bind-Value="mData.DurationMilliseconds" />
                  </div>
                  <div class="form-group">
                     <label for="uiCooldown"><b>Main Cooldown (in minutes):</b></label>
                     <small id="uiCooldown" class="form-text text-white-50">The number of minutes this command must wait before triggered again via chat. This cooldown does not apply if the animation is redeemed via Twitch events.</small>
                     <MudNumericField T="int" Min="0" Max="300" @bind-Value="mData.MainCooldownMinutes" />
                  </div>
                  <div class="form-group">
                     <label for="uiAudioOffset"><b>Audio Offset (in milliseconds):</b></label>
                     <small id="uiAudioOffset" class="form-text text-white-50">Plays the audio file on a delay <i>after</i> the visual is played (<i>Math Reminder: 1 second = 1000ms</i>).</small>
                     <MudNumericField T="int" Min="0" Max="600000" @bind-Value="mData.AudioTimingOffsetMilliseconds" />
                  </div>
               </MudExpansionPanel>

               <MudExpansionPanel Text="Access Level" Expanded="true">
                  <div class="form-group">
                     <label for="uiAccess"><b>Access Type:</b></label>
                     <small id="uiAccess" class="form-text text-white-50">
                        You can limit what kind of viewer has access to use this animation. Your options are below. If you are making
                        this command to be used from within another command, it is recommended to flag it as Bot Only!
                     </small>
                     <MudRadioGroup @bind-Value="mAccessSelection" T="int">
<MudRadio T="int" Value="@(0)">Anyone</MudRadio>
                           <MudRadio T="int" Value="@(2)">Subscriber</MudRadio>
                           <MudRadio T="int" Value="@(3)">VIP</MudRadio>
                           <MudRadio T="int" Value="@(4)">Moderator</MudRadio>
                           <MudRadio T="int" Value="@(5)">User Group</MudRadio>
                           <MudRadio T="int" Value="@(6)">Specific Viewer</MudRadio>
                           <MudRadio T="int" Value="@(7)">Bot Only</MudRadio>
</MudRadioGroup>
                  </div>

                  @if (mData.Access == AnimationEnums.AccessType.UserGroup)
                  {
                     <div class="form-group">
                        <label for="uiUserGroup"><b>User Group:</b></label>
                        <small id="uiUserGroup" class="form-text text-white-50">Access is restricted to a user group. Which one?</small>

                        <MudSelect T="string" Placeholder="Select User Group..." Style="width: 250px;"
 Value="@mSelectedUserGroupName" ValueChanged="@(args => OnUserGroupSelected.InvokeAsync(args as string))" />
                     </div>
                  }
                  else if (mData.Access == AnimationEnums.AccessType.SpecificViewer)
                  {
                     <div class="form-group">
                        <label for="uiRestrictedToUser"><b>Specific Viewer:</b></label>
                        <small id="uiRestrictedToUser" class="form-text text-white-50">Access is restricted to a specific viewer. Which one?</small>
                        <MudTextField T="string" @bind-Value="@mData.RestrictedToUser" />
                     </div>
                     <div class="mt-2">
                        <MudCheckBox T="bool" @bind-Value="mData.RestrictedUserMustBeSub" Label="Viewer must be subscribed" />
                     </div>
                  }
               </MudExpansionPanel>
            </div>
         </div>
      </MudTabPanel>
      <MudTabPanel Text="Positioning">
         <div class="p-0 m-0 rounded gifbot-section-panel">
            @if (AnimationLibrary.GetFileTypeOfAnimation(mData.Visual) == AnimationEnums.FileType.Video)
            {
               <div class="p-2">
                  <div class="form-group form-check">
                     <MudCheckBox T="bool" @bind-Value="mData.IsMirrored" Label="Mirroring: This animation should be flipped horizontally." />
                  </div>
               </div>
            }
            <div class="p-2">
               <PlacementComponent Width="@mData.Placement.Width"
                                   Height="@mData.Placement.Height"
                                   Top="@mData.Placement.Top"
                                   Left="@mData.Placement.Left"
                                   IsOutOfBounds="@mData.Placement.IsOutOfBounds"
                                   ShowCommitButton="false"
                                   OnDisplayTestModeChanged="@(args => OnDisplayTestModeChanged.InvokeAsync(args))"
                                   OnNotifyDimensionsChanged="@(args => HandlePlacementUpdated(args))" />
            </div>
         </div>
      </MudTabPanel>
      <MudTabPanel Text="Trigger Options">
         <div class="p-0 m-0 rounded gifbot-section-panel">
            <div class="p-2">
               <MudTabs ApplyEffectsToContainer="true" Elevation="0" Rounded="true" PanelClass="pa-3">
                  <MudTabPanel Text="Twitch Events">
                     <div class="p-0 m-0 rounded gifbot-section-panel">
                        <div class="p-2">
                           <MudExpansionPanel Text="Cheer Requirements" Expanded="true">
                              <div class="form-group form-check">
                                 <MudCheckBox T="bool" @bind-Value="mData.IsBitAlert" Label="Trigger when someone cheers bits" />
                              </div>
                              @if (mData.IsBitAlert)
                              {
                                 <div class="form-group">
                                    <small id="uiRequirementBits" class="form-text text-white-50">Require an exact number of bits to be cheered before this animation will trigger. Leave at 0 if you would like this to trigger for all cheers.</small>
                                    <MudNumericField T="int" Min="0" Max="999999" @bind-Value="mData.BitRequirement" />
                                 </div>
                                 <div class="form-group">
                                    <label for="uiBitAlertBehavior"><b>Bit Alert Behavior:</b></label>
                                    <small id="uiBitAlertBehavior" class="form-text text-white-50">
                                       Bit alerts have two types of behaviors. You can opt to perform an exact match on the bits cheered, or the bits cheered can hit a minimum. This allows
                                       you to create catch-all alerts for ranges of values, but an exact match alert for bits cheered will always be prioritized.
                                    </small>
                                    <MudRadioGroup @bind-Value="mBitBehaviorSelection" T="int">
<MudRadio T="int" Value="@(0)">Exact Match</MudRadio>
                                          <MudRadio T="int" Value="@(1)">Minimum (>= Your Value)</MudRadio>
</MudRadioGroup>
                                 </div>
                                 <div class="form-group form-check">
                                    <MudCheckBox T="bool" @bind-Value="mData.BitsMustBePairedWithCommand" Label="Cheering must be paired with the command. (Allows users to target a specific animation when there are multiple with the same cheer amount. Example: !commandname cheer25)" />
                                 </div>
                              }
                           </MudExpansionPanel>
                           <MudExpansionPanel Text="Raid Alerts" Expanded="true">
                              <div class="form-group form-check">
                                 <MudCheckBox T="bool" @bind-Value="mData.IsRaidAlert" Label="Trigger when someone raids the channel" />
                              </div>
                              @if (mData.IsRaidAlert)
                              {
                                 <div class="form-group">
                                    <label for="uiRestrictedToRaid"><b>Restricted to Raids By User:</b></label>
                                    <small id="uiRestrictedToRaid" class="form-text text-white-50">Only triggers if this specific user raids. You may leave this blank to trigger for all raids.</small>
                                    <MudTextField T="string" @bind-Value="mData.RaidRestrictedToUsername" />
                                 </div>
                              }
                           </MudExpansionPanel>
                           <MudExpansionPanel Text="Subscriber Alerts" Expanded="true">
                              <div class="form-group form-check">
                                 <MudCheckBox T="bool" @bind-Value="mData.IsSubAlertTrigger" Label="Trigger when someone subscribes/resubscribes" />
                              </div>
                              @if (mData.IsSubAlertTrigger)
                              {
                                 <div class="form-group">
                                    <label for="uiSubMonths"><b>Months Subscribed:</b></label>
                                    <small id="uiSubMonths" class="form-text text-white-50">A subscriber must subscribe or resubscribe with the number of months to trigger the animation. (0 = no restriction)</small>
                                    <MudNumericField T="int" Min="0" Max="2500" @bind-Value="mData.SubscriptionMonthsRequired" />
                                 </div>
                                 <div class="form-group">
                                    <label for="uiSubTier"><b>Tier:</b></label>
                                    <small id="uiSubTier" class="form-text text-white-50">What sub tier is this for?</small>
                                    <MudRadioGroup @bind-Value="mSubTierSelection" T="int">
<MudRadio T="int" Value="@(0)">All</MudRadio>
                                          <MudRadio T="int" Value="@(1)">Prime</MudRadio>
                                          <MudRadio T="int" Value="@(2)">Tier 1</MudRadio>
                                          <MudRadio T="int" Value="@(3)">Tier 2</MudRadio>
                                          <MudRadio T="int" Value="@(4)">Tier 3</MudRadio>
</MudRadioGroup>
                                 </div>
                              }
                           </MudExpansionPanel>
                           <MudExpansionPanel Text="Gift Sub Bomb Alerts" Expanded="true">
                              <div class="form-group form-check">
                                 <MudCheckBox T="bool" @bind-Value="mData.IsGiftSubAlertTrigger" Label="Trigger when someone gifts subscriptions" />
                              </div>
                              @if (mData.IsGiftSubAlertTrigger)
                              {
                                 <div class="form-group">
                                    <label for="uiNumGifted"><b>Number of Gift Subscriptions to Trigger</b></label>
                                    <small id="uiNumGifted" class="form-text text-white-50">The number of subscriptions that have to be gifted in one event to trigger. The number must match, or you may say 0 for this to fire on all gift subscription events.</small>
                                    <MudNumericField T="int" Min="0" Max="2500" @bind-Value="mData.GiftSubCountRequirement" />
                                 </div>
                              }
                           </MudExpansionPanel>
                           @*<MudExpansionPanel Text="Hype Train Leveling" Expanded="true">
                           <div class="form-group form-check">
                           <label class="form-check-label">
                           <MudCheckBox T="bool" @bind-Value="mData.IsHypeTrainTrigger" Label="Trigger when a new hype train level has been reached" />
                           </label>
                           </div>
                           @if (mData.IsHypeTrainTrigger)
                           {
                           <div class="form-group">
                           <label for="uiHypeTrainLevel"><b>Hype Train Level:</b></label>
                           <small id="uiHypeTrainLevel" class="form-text text-white-50">The level of hype train that must be reached to trigger this animation.</small>
                           <MudNumericField T="int" Min="0" Max="2500" @bind-Value="mData.HypeTrainLevel" />
                           </div>
                           }
                           </MudExpansionPanel>*@
                        </div>
                     </div>
                  </MudTabPanel>

                  <MudTabPanel Text="Channel Point Rewards">
                     <div class="p-0 m-0 rounded gifbot-section-panel">
                        <div class="p-2">
                           <div class="text-white-50 p-0">
                              <p>There are a few options for reacting to channel point redemptions. You can simply listen for any redemptions and treat this animation as an alert. It will always be queued first to play. You can ask users to input the command text in their redemption message OR you can listen directly for a specific point amount, which will be good for larger animation events.</p>
                              <p>
                                 Please note that any rewards requiring user input will go into a queue that you have to clear manually on your dashboard.
                                 If you would like a redemption reward for playing a specific animation, you can put the command text in the title of the
                                 reward. GIFBot will check for that first, then look at the points spent if a matching animation is not found.
                              </p>
                              <p>GIFBot commands supported in reward titles for redemption: !animationroulette, !regurgitator (or whatever you may have customized them to).</p>
                              <p>At this time, Twitch has not exposed a way to grab the list of rewards, so make sure your animation options match the reward costs if you go this route. If you have rewards that cost the same, you could end up with multiple animations triggering, so be mindful when you set them up.</p>
                              <p>** Note that if you turn on channel point redemption, the follower, subscriber, moderator, and VIP flags will NOT be applied.</p>
                           </div>
                           <div class="form-group">
                              <label for="uiChannelPointLevel"><b>Options:</b></label>
                              <MudRadioGroup @bind-Value="mChannelPointSelection" T="int">
<MudRadio T="int" Value="@(0)">Disabled</MudRadio>
                                    <MudRadio T="int" Value="@(1)">Trigger on all channel point redemptions. Will be have as an alert and always be queued.</MudRadio>
                                    <MudRadio T="int" Value="@(2)">Trigger by the redemption message. The command must be in the message (user input required).</MudRadio>
                                    <MudRadio T="int" Value="@(3)">Trigger by the number of points spent (does not require user input).</MudRadio>
</MudRadioGroup>
                           </div>
                           @if (mData.ChannelPointRedemptionType == AnimationEnums.ChannelPointRedemptionTriggerType.PointsUsed)
                           {
                              <div class="form-group">
                                 <label for="uiNumChannelPoints"><b>Number of Channel Points Spent to Trigger (exact match)</b></label>
                                 <small id="uiNumChannelPoints" class="form-text text-white-50">The number of points that must be spent in order to trigger this animation. The number must match the cost in your Stream Manager.</small>
                                 <MudNumericField T="int" Min="1" Max="100000000" Value="@mData.ChannelPointsRequired" ValueChanged="@((int val) => { mData.ChannelPointsRequired = val; HandleChannelPointRequirementChanged(val); })" />
                              </div>
                           }
                        </div>
                     </div>
                  </MudTabPanel>

                  <MudTabPanel Text="Tips">
                     <div class="p-0 m-0 rounded gifbot-section-panel">
                        <div class="text-white-50 p-0">
                           <p>
                              If you are authenticated with Streamlabs or StreamElements, you can receive tip alerts from their respective services
                              to use in GIFBot. In order to authenticate, please go to your Bot Settings -> Integrations.
                           </p>
                        </div>
                        <div class="p-2">
                           <MudExpansionPanel Text="Tip Requirement" Expanded="true">
                              <div class="form-group form-check">
                                 <MudCheckBox T="bool" @bind-Value="mData.IsStreamlabsTipTrigger" Label="Trigger when tips are made through Streamlabs or StreamElements" />
                              </div>
                              @if (mData.IsStreamlabsTipTrigger)
                              {
                                 <div class="form-group">
                                    <small id="uiTipRequirement" class="form-text text-white-50">Amount of currency to be tipped before this animation will trigger (0 = all tips).</small>
                                    <MudNumericField T="double" Min="0" Max="100000" @bind-Value="mData.StreamlabsTipRequirement" />
                                 </div>
                              }
                           </MudExpansionPanel>
                        </div>
                     </div>
                  </MudTabPanel>

                  <MudTabPanel Text="Charity">
                     <div class="p-0 m-0 rounded gifbot-section-panel">
                        <div class="text-white-50 p-0">
                           <p>
                              If you are authenticated with Tiltify, you can receive donation alerts from their services
                              to use in GIFBot. In order to authenticate, please go to your Bot Settings -> Integrations. Make
                              sure to select your active campaign!
                           </p>
                        </div>
                        <div class="p-2">
                           <MudExpansionPanel Text="Tip Requirement" Expanded="true">
                              <div class="form-group form-check">
                                 <MudCheckBox T="bool" @bind-Value="mData.IsTiltifyTrigger" Label="Trigger when donations are made through Tiltify" />
                              </div>
                              @if (mData.IsTiltifyTrigger)
                              {
                                 <div class="form-group">
                                    <small id="uiTilitifyRequirement" class="form-text text-white-50">Amount of currency to be donated before this animation will trigger (0 = all donations).</small>
                                    <MudNumericField T="double" Min="0" Max="1000000" @bind-Value="mData.TiltifyDonationRequirement" />
                                 </div>
                              }
                           </MudExpansionPanel>
                        </div>
                     </div>
                  </MudTabPanel>

                  <MudTabPanel Text="Chat Output">
                     <div class="p-0 m-0 rounded gifbot-section-panel">
                        <div class="p-2">
                           <div class="mt-2">
                              <label for="uiPrePlayText"><b>Pre Play Text:</b></label>
                              <small id="uiPrePlayText" class="form-text text-white-50">Text that is sent to chat just prior to playing the animation. If triggered from chat, use $user in the place where you would like to have the trigger's name appear in the message.</small>
                              <MudTextField T="string" @bind-Value="mData.PrePlayText" />
                           </div>
                           <div class="mt-2">
                              <label for="uiPostPlayText"><b>Post Play Text:</b></label>
                              <small id="uiPostPlayText" class="form-text text-white-50">Text that is sent to chat after playing the animation. If triggered from chat, use $user in the place where you would like to have the trigger's name appear in the message.</small>
                              <MudTextField T="string" @bind-Value="mData.PostPlayText" />
                           </div>
                        </div>
                     </div>
                  </MudTabPanel>
               </MudTabs>
            </div>
         </div>
      </MudTabPanel>
      <MudTabPanel Text="Variations">
         <div class="p-0 m-0 rounded gifbot-section-panel">
            <div class="p-2">
               <div class="text-white-50 p-0">
                  <p>
                     Variations offer you a great opportunity to use the same command, but have different sounds or visuals play randomly when it's used.
                     Variations will use the same placement data as the parent animation; however, you can provide a separate volume and duration for each.
                  </p>
               </div>
               <div class="form-group mt-2">
                  <label for="uiPlayAllVariantsBeforeRepeat"><b>Variations Repeat Behavior:</b></label>
                  <small id="uiPlayAllVariantsBeforeRepeat" class="form-text text-white-50">Would you like all variations to be played before they can repeat? If enabled, all variations in the grid below will have to play at least once before they can be played again. Otherwise, they stand a chance of being repeated with multiple command executions.</small>
                  <MudCheckBox T="bool" @bind-Value="mData.PlayAllVariantsBeforeRepeat" Label="Play all variants before repeating" />
               </div>
               <div class="form-group">
                  <label for="uiVariationsGrid"><b>Variations:</b></label>
                  <MudDataGrid T="AnimationVariantData" Items="@mData.Variants" SortMode="SortMode.Single">
                     <Columns>
                        <PropertyColumn T="AnimationVariantData" TProperty="string" Property="@(x => x.Visual)" Title="Visual" Editable="false" />
                        <PropertyColumn T="AnimationVariantData" TProperty="string" Property="@(x => x.Audio)" Title="Audio" Editable="false" />
                        <PropertyColumn T="AnimationVariantData" TProperty="double" Property="@(x => x.Volume)" Title="Volume" />
                        <PropertyColumn T="AnimationVariantData" TProperty="int" Property="@(x => x.DurationMilliseconds)" Title="Duration (in ms)" />
                        <PropertyColumn T="AnimationVariantData" TProperty="int" Property="@(x => x.AudioTimingOffsetMilliseconds)" Title="Offset (in ms)" />
                        <PropertyColumn T="AnimationVariantData" TProperty="string" Property="@(x => x.PrePlayText)" Title="PrePlayText" />
                        <PropertyColumn T="AnimationVariantData" TProperty="string" Property="@(x => x.PostPlayText)" Title="PostPlayText" />
