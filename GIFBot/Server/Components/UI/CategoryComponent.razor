@using global::GIFBot.Shared
@using global::GIFBot.Server.Components.UI
@using global::GIFBot.Server.Components.Pages.Setup.Models

<div class="mt-1">
   <EditForm Model="@mCategoryNameModel" OnSubmit="@HandleSave">
      <div class="p-2 mb-2 rounded gifbot-content-panel">
         <div class="text-left" style="width: 100%">
            <MudButton Variant="Variant.Filled" Class="p-1 gifbot-danger-btn" Style="margin-left: auto; margin-right: 0" OnClick="@OnDeleteCategory">Delete</MudButton>
            <MudButton Variant="Variant.Filled" Class="p-1 gifbot-special-btn" Style="margin-left: auto; margin-right: 0" OnClick="@(() => OnToggleEnabledAll.InvokeAsync(true))">Enable All Animations</MudButton>
            <MudButton Variant="Variant.Filled" Class="p-1 gifbot-special-btn" Style="margin-left: auto; margin-right: 0" OnClick="@(() => OnToggleEnabledAll.InvokeAsync(false))">Disable All Animations</MudButton>
         </div>
      </div>
      <MudTabs ApplyEffectsToContainer="true" Elevation="0" Rounded="true" PanelClass="pa-3">
         <MudTabPanel Text="General">
            <div class="p-0 m-0 rounded gifbot-section-panel">
               <div class="p-2">
                  <div class="form-group">
                     <label for="uiTitle"><b>Category Name:</b></label>
                     <span id="uiTitle" class="gifbot-field-desc">It's pretty self-explanatory. Basically it's the title of the category.</span>
                     <MudTextField T="string" @bind-Value="mCategoryNameModel.Name" />
                  </div>
               </div>
            </div>
         </MudTabPanel>
         @*<MudTabPanel Text="Bulk Actions">
            <div class="p-0 m-0 rounded gifbot-section-panel">
               <div class="p-2">
               </div>
            </div>
         </MudTabPanel>*@
      </MudTabs>

               <div class="d-flex justify-end pa-3">
            <MudButton Variant="Variant.Filled" Class="p-2 gifbot-secondary-btn" ButtonType="ButtonType.Reset" OnClick="@OnCancel">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="p-2" ButtonType="ButtonType.Submit">Save Changes</MudButton>
         </div>
   </EditForm>
</div>

@code {

   /// <summary>
   /// The source data.
   /// </summary>
   [Parameter]
   public AnimationCategory Data
   {
      get { return mData; }
      set
      {
         mData = value;
         mCategoryNameModel = new TwitchNameModel();
         mCategoryNameModel.Name = mData.Title;
         StateHasChanged();
      }
   }

   /// <summary>
   /// Event fired when the user saves.
   /// </summary>
   [Parameter]
   public EventCallback<string> OnSave { get; set; }

   /// <summary>
   /// Event fired when the user cancels.
   /// </summary>
   [Parameter]
   public EventCallback OnCancel { get; set; }

   /// <summary>
   /// Event fired when the user wants to delete a category.
   /// </summary>
   [Parameter]
   public EventCallback OnDeleteCategory { get; set; }

   /// <summary>
   /// Event fired when the user wants to enable or disable all animations in the category.
   /// </summary>
   [Parameter]
   public EventCallback<bool> OnToggleEnabledAll { get; set; }

   /// <summary>
   /// Handles the save action.
   /// </summary>
   protected async Task HandleSave()
   {
      await OnSave.InvokeAsync(mCategoryNameModel.Name);
   }

   #region Private Members

   private AnimationCategory mData;
   private TwitchNameModel mCategoryNameModel = new TwitchNameModel();

   #endregion

}
