@page "/charity"
@inject NavigationManager NavigationManager

<div class="pa-1 my-1 gifbot-page-header">
   <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
      <MudIcon Icon="@Icons.Material.Filled.Favorite" />
      <MudText Typo="Typo.h4">A Special Thanks...</MudText>
   </MudStack>
</div>

<div class="p-2 mb-2 rounded gifbot-content-panel">
   <div class="text-white-50 mb-4" style="width: 700px">
      The Fiercekittenz community is small, but mighty! We have collectively raised over $36,000 since 2017! That's a lot of doll hairs for charity! This page is here
      to thank each and every donor to the various causes that we have helped over the years. Thank you. Truly. Every little bit helps, and I cannot thank you enough!
   </div>
   <div class="text-white-50 mb-4" style="width: 700px">
      <ul>
         @foreach (var donor in Donors)
         {
            <li>@donor</li>
         }
      </ul>
   </div>
</div>

