@page "/regurgitator/"
@using Microsoft.AspNetCore.SignalR.Client
@using global::GIFBot.Shared
@using global::GIFBot.Shared.Models.Animation
@using global::GIFBot.Shared.Models.Visualization
@using Newtonsoft.Json
@using Microsoft.AspNetCore.Http.Connections
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@implements IAsyncDisposable

<div class="pa-1 my-1 gifbot-page-header">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.RecordVoiceOver" />
        <MudText Typo="Typo.h4">Regurgitator</MudText>
    </MudStack>
</div>

<MudPaper Class="pa-2 mb-2" Elevation="0" Style="background-color: #1c1c34">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.subtitle1" Class="mr-2"><b>Package:</b></MudText>
        <MudSelect T="Guid" Placeholder="Select Package to Edit..." @bind-Value="@CurrentPackage">
            @if (AvailablePackages != null)
            {
                @foreach (var pkg in AvailablePackages)
                {
                    <MudSelectItem T="Guid" Value="@pkg.Id">@pkg.Name</MudSelectItem>
                }
            }
        </MudSelect>
        <MudButton Variant="Variant.Filled" Class="gifbot-action-btn" Style="width:100px" OnClick="@AddNewPackage">Add</MudButton>
        <MudButton Variant="Variant.Filled" Class="gifbot-action-btn" Style="width:100px" OnClick="@DeletePackage">Delete</MudButton>
    </MudStack>
</MudPaper>

@if (CurrentPackage != Guid.Empty)
{
    <EditForm Model="@mRegurgitatorSettings" OnSubmit="@OnSaveChanges">
        <div style="width: 100%">
            <div class="text-left p-3 rounded gifbot-form-panel" style="width: 100%">
                <MudTabs @bind-ActivePanelIndex="@ActiveTabIndex" ApplyEffectsToContainer="true" Elevation="0" Rounded="true" PanelClass="pa-3">
                    <MudTabPanel Text="Settings">
                        <div class="p-0 m-0 rounded gifbot-section-panel">
                            <div class="p-2">
                                <p>
                                    The <b>Regurgitator</b> is a feature of GIFBot where you can have a command
                                    or timed event to regurgitate a random entry (fact, pun, dad joke, etc.) to chat. To use, simply enable and
                                    provide a text file of sentences, separated by a line feed (return/enter).
                                </p>

                            <div class="form-group form-check">
                                <MudCheckBox T="bool" @bind-Value="mRegurgitatorSettings.Enabled" Label="Package Enabled" />
                                <span id="uiEnabled" class="gifbot-field-desc">When enabled, the bot will allow this package's command to regurgitate to chat. Sounds nasty, right? Thanks dewritten.</span>
                            </div>

                            <div class="form-group form-check">
                                <MudCheckBox T="bool" @bind-Value="mRegurgitatorSettings.PlayOnTimer" Label="Play on Timer" />
                                <span id="uiPlayOnTimer" class="gifbot-field-desc">When enabled, the package will periodically send one of its entries to chat. The chat command is disabled when this is on.</span>
                            </div>

                            @if (!mRegurgitatorSettings.PlayOnTimer)
                            {
                                <div class="form-group">
                                    <label for="uiCommand">Command:</label>
                                    <span id="uiCommand" class="gifbot-field-desc">This is the command viewers can use in chat to regurgitate a random entry from this package.</span>
                                    <DataAnnotationsValidator />
                                    <ValidationSummary />
                                    <MudTextField T="string" @bind-Value="mRegurgitatorSettings.Command" />
                                </div>

                                <div class="form-group">
                                    <label for="uiMinutesBetweenChatRequests">Cooldown for Chat Command (in minutes):</label>
                                    <span id="uiMinutesBetweenChatRequests" class="gifbot-field-desc">The number of minutes that must pass before this chat command can be used again.</span>
                                    <DataAnnotationsValidator />
                                    <ValidationSummary />
                                    <MudNumericField T="int" Min="0" Max="120" @bind-Value="mRegurgitatorSettings.MinutesBetweenChatRequests" />
                                </div>

                                <div class="form-group">
                                    <label for="uiAccess"><b>Access Type:</b></label>
                                    <span id="uiAccess" class="gifbot-field-desc">
                                        You can limit what kind of viewer has access to use this feature when used from chat commands. Your options are below. If you want
                                        the regurgitator to be used by any feature other than chat, you should set it as "Bot Only".
                                    </span>
                                    <MudRadioGroup @bind-Value="mAccessSelection" T="int">
<MudRadio T="int" Value="@(0)">Anyone</MudRadio>
                                            <MudRadio T="int" Value="@(2)">Subscriber</MudRadio>
                                            <MudRadio T="int" Value="@(3)">VIP</MudRadio>
                                            <MudRadio T="int" Value="@(4)">Moderator</MudRadio>
                                            <MudRadio T="int" Value="@(5)">User Group</MudRadio>
                                            <MudRadio T="int" Value="@(6)">Specific Viewer</MudRadio>
                                            <MudRadio T="int" Value="@(7)">Bot Only</MudRadio>
</MudRadioGroup>
                                </div>

                                @if (mRegurgitatorSettings.Access == AnimationEnums.AccessType.UserGroup)
                                {
                                    <div class="form-group">
                                        <label for="uiUserGroup"><b>User Group:</b></label>
                                        <span id="uiUserGroup" class="gifbot-field-desc">Access is restricted to a user group. Which one?</span>

                                        <MudSelect T="string" Placeholder="Select User Group..." Style="width: 250px;"
 Value="@mSelectedUserGroupName" ValueChanged="@(args => HandleUserGroupSelected(args as string))" />
                                    </div>
                                }
                                else if (mRegurgitatorSettings.Access == AnimationEnums.AccessType.SpecificViewer)
                                {
                                    <div class="form-group">
                                        <label for="uiRestrictedToUser"><b>Specific Viewer:</b></label>
                                        <span id="uiRestrictedToUser" class="gifbot-field-desc">Access is restricted to a specific viewer. Which one?</span>
                                        <MudTextField T="string" @bind-Value="@mRegurgitatorSettings.RestrictedToUser" />
                                    </div>
                                    <div class="mt-2">
                                        <MudCheckBox T="bool" @bind-Value="mRegurgitatorSettings.RestrictedUserMustBeSub" Label="Viewer must be subscribed" />
                                    </div>
                                }

                                <MudExpansionPanel Text="Text-to-Speech (TTS)" Expanded="true">
                                    <div class="form-group form-check">
                                        <MudCheckBox T="bool" @bind-Value="mRegurgitatorSettings.AllowTTSReading" Label="Use Text-to-Speech to read selected entries as a sound-only Animation instead of sending to chat." />
                                    </div>
                                    <div class="form-group">
                                        <label for="uiVolumeSlider" class="ml-2 mt-2"><b>TTS Volume:</b></label>
                                        <MudSlider T="int" @bind-Value="mFormVolume" Min="0" Max="100" />
                                    </div>
                                    <div class="form-group">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="p-1 mr-2 mb-2 text-center gifbot-action-btn" Style="width: 200px" OnClick="@HandleTestTTSVolume">
                                            Test TTS Volume
                                        </MudButton>
                                    </div>
                                </MudExpansionPanel>
                            }
                            else
                            {
                                <div class="form-group">
                                    <label for="uiFrequencyInSeconds">Frequency in Seconds:</label>
                                    <span id="uiFrequencyInSeconds" class="gifbot-field-desc">The number of seconds in between entries being sent to chat, when Play On Timer is enabled.</span>
                                    <DataAnnotationsValidator />
                                    <ValidationSummary />
                                    <MudNumericField T="int" @bind-Value="mRegurgitatorSettings.TimerFrequencyInSeconds" />
                                </div>
                            }
                            </div>
                        </div>
                    </MudTabPanel>

            <MudTabPanel Text="Trigger Costs">
                <div class="p-0 m-0 rounded gifbot-section-panel">
                    <div class="p-2">
                        <MudExpansionPanel Text="Cheer Requirements" Expanded="true">
                            <div class="form-group">
                                <span id="uiRequirementBits" class="gifbot-field-desc">Require an exact number of bits to be cheered before the regurgitator will trigger. Leave the value at 0 to disable.</span>
                                <MudNumericField T="int" Min="0" Max="100000" @bind-Value="mRegurgitatorSettings.BitRequirement" />
                            </div>
                        </MudExpansionPanel>

                        <MudExpansionPanel Text="Streamlabs Tip Requirement" Expanded="true">
                            <div class="form-group form-check">
                                <MudCheckBox T="bool" @bind-Value="mRegurgitatorSettings.IsStreamlabsTipTrigger" Label="Trigger when tips are made through Streamlabs" />
                            </div>
                            @if (mRegurgitatorSettings.IsStreamlabsTipTrigger)
                            {
                                <div class="form-group">
                                    <span id="uiTipRequirement" class="gifbot-field-desc">Amount of currency to be tipped before the regurgitator will trigger (0 = all tips).</span>
                                    <MudNumericField T="double" Min="0" Max="100000" @bind-Value="mRegurgitatorSettings.StreamlabsTipRequirement" />
                                </div>
                            }
                        </MudExpansionPanel>

                        <MudExpansionPanel Text="Tiltify via Streamlabs Donation Requirement" Expanded="true">
                            <div class="form-group form-check">
                                <MudCheckBox T="bool" @bind-Value="mRegurgitatorSettings.IsTiltifyTrigger" Label="Trigger when charitable donations are made through Tiltify" />
                            </div>
                            @if (mRegurgitatorSettings.IsTiltifyTrigger)
                            {
                                <div class="form-group">
                                    <span id="uiDonationAmount" class="gifbot-field-desc">Amount of currency to be donated before this animation will trigger (0 = all donations).</span>
                                    <MudNumericField T="double" Min="0" Max="100000" @bind-Value="mRegurgitatorSettings.TiltifyDonationRequirement" />
                                </div>
                            }
                        </MudExpansionPanel>
                    </div>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Data Entries">
                <div class="p-0 m-0 rounded gifbot-section-panel">
                    <div class="p-2">
                        <div class="form-group">
                            <label for="uiEntries">Entries:</label>
                            <span id="uiEntries" class="gifbot-field-desc">These are the items that will be randomly regurgitated. You can add or delete entries here.</span>

                            <MudDataGrid T="RegurgitatorEntry" Items="@CurrentEntries" SortMode="SortMode.Single">
                                <Columns>
                                    <PropertyColumn T="RegurgitatorEntry" TProperty="string" Property="@(x => x.Value)" Title="Value" />
                                    <TemplateColumn Title="">
<CellTemplate Context="data">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="gifbot-neutral-btn" OnClick="(() => OnDeleteEntry((data.Item)))" title="Delete" />
                                        </CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                            </MudDataGrid>

                            <div class="d-flex align-center gap-2 mt-2">
                                <MudTextField T="string" @bind-Value="@mNewEntryText" Style="flex-grow: 1" />
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gifbot-action-btn" Style="width: 200px" StartIcon="@Icons.Material.Filled.Add" OnClick="@OnAddNewEntry">Add New Entry</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gifbot-action-btn" Style="width: 150px" OnClick="@OnClearList">Clear List</MudButton>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="uiImport">Import from Text File:</label>
                            <span id="uiImport" class="gifbot-field-desc">
                                You can import directly from a text file. Each entry should be on its own line in the text file.
                            </span>
                            @* TODO: Wire up file upload handler *@
<InputFile accept="text/*" style="width: 100%; background-color: #16162e" />
                            @if (mUploadProgress > 0)
                            {
                                <MudProgressLinear Value="@mUploadProgress" Style="margin-bottom: 20px; width: 100%" />
                            }
                            @if (!String.IsNullOrEmpty(mUploadErrorMessage))
                            {
                                <label class="text-danger">@mUploadErrorMessage</label>
                            }
                        </div>
                    </div>
                </div>
            </MudTabPanel>
                </MudTabs>
                <div class="d-flex justify-end pa-3 gap-4">
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@OnCancel">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">Save Changes</MudButton>
                </div>
            </div>
        </div>
    </EditForm>
}

<!-- Delete Package Dialog -->
<MudDialog @bind-Visible="@mIsDeletePackageDialogVisible">
    <TitleContent>
        <MudText Typo="Typo.h6">Confirm Delete</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Are you sure you want to delete the package <b>@mPendingDeletePackageName</b>?</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => mIsDeletePackageDialogVisible = false)">Cancel</MudButton>
        <MudButton Color="Color.Error" OnClick="@HandleConfirmDeletePackage">Delete</MudButton>
    </DialogActions>
</MudDialog>

<!-- Clear List Dialog -->
<MudDialog @bind-Visible="@mIsClearListDialogVisible">
    <TitleContent>
        <MudText Typo="Typo.h6">Confirm Clear List</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Are you sure you want to clear all entries from this package? This action cannot be undone.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => mIsClearListDialogVisible = false)">Cancel</MudButton>
        <MudButton Color="Color.Error" OnClick="@HandleConfirmClearList">Clear List</MudButton>
    </DialogActions>
</MudDialog>
