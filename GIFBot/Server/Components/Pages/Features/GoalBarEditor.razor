@page "/goalbareditor/"
@using Microsoft.AspNetCore.SignalR.Client
@using global::GIFBot.Shared.Models.Features
@using global::GIFBot.Shared.Models.Visualization
@using global::GIFBot.Server.Components.UI
@using Newtonsoft.Json
@using Microsoft.AspNetCore.Http.Connections
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@implements IAsyncDisposable

<MudDialog @bind-Visible="@mIsNewGoalPromptVisible">
   <TitleContent>
      <MudText Typo="Typo.h6">Add New Goal</MudText>
   </TitleContent>
   <DialogContent>
      <MudText Typo="Typo.subtitle1"><b>Goal Title</b></MudText>
      <MudText Typo="Typo.caption" Class="text-white-50 mb-2">The purpose of your goal (e.g. "New Camera" or "Sweet Mic").</MudText>
      <MudTextField T="string" @bind-Value="mNewGoalTitle" Placeholder="Enter goal title..." />
   </DialogContent>
   <DialogActions>
      <MudButton OnClick="@HandleCancelAddGoal">Cancel</MudButton>
      <MudButton Color="Color.Primary" OnClick="@HandleAddNewGoal">Add</MudButton>
   </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="@mIsDeleteGoalDialogVisible">
   <TitleContent>
      <MudText Typo="Typo.h6">Confirm Delete</MudText>
   </TitleContent>
   <DialogContent>
      <MudText>Are you sure you want to delete this goal? This action cannot be undone.</MudText>
   </DialogContent>
   <DialogActions>
      <MudButton OnClick="@(() => mIsDeleteGoalDialogVisible = false)">Cancel</MudButton>
      <MudButton Color="Color.Error" OnClick="@HandleConfirmDeleteGoal">Delete</MudButton>
   </DialogActions>
</MudDialog>

<div class="pa-1 my-1 gifbot-page-header">
   <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
      <MudIcon Icon="@Icons.Material.Filled.TrackChanges" />
      <MudText Typo="Typo.h4">Goal Bar</MudText>
   </MudStack>
</div>

<EditForm Model="@mGoalBarData" OnSubmit="@OnSaveChanges">
   <div style="width: 100%">
      <div class="text-left p-3 rounded gifbot-form-panel" style="width: 100%">
   <MudTabs @bind-ActivePanelIndex="@ActiveTabIndex" ApplyEffectsToContainer="true" Elevation="0" Rounded="true" PanelClass="pa-3">
      <MudTabPanel Text="Settings">
               <p>
                  The <b>Goal Bar</b> is a feature of GIFBot where you can have a monetary or point-based goal that
                  takes into consideration multiple types of Twitch events (cheering, subbing, gift subbing, and tips).
               </p>
               <div class="p-0 m-0 rounded gifbot-section-panel">
                  <div class="p-2">

                  <div class="form-group form-check">
                     <MudCheckBox T="bool" @bind-Value="mGoalBarData.Settings.Enabled" Label="Feature Enabled" />
                     <span id="uiEnabled" class="gifbot-field-desc">When enabled, Twitch events will be computed and have their values applied to the goal.</span>
                  </div>

                  <MudExpansionPanel Text="Goal Triggers" Expanded="true">
                     <div class="form-group form-check">
                        <MudCheckBox T="bool" @bind-Value="mGoalBarData.Settings.IncludeCheers" Label="Include Cheers" />
                        <span id="uiIncludeCheers" class="gifbot-field-desc">When enabled, cheering will count toward the goal.</span>
                     </div>

                     @if (mGoalBarData.Settings.IncludeCheers)
                     {
                        <div class="form-group">
                           <label for="uiBitPointsLabel">Bit Point Amount:</label>
                           <span id="uiBitPointsLabel" class="gifbot-field-desc">The number of points applied to the goal per bit cheered. If you would like to only count bits, make sure you either set this value to 1 <i>OR</i> make sure the goal is the dollar amount of bits you want to achieve.</span>
                           <DataAnnotationsValidator />
                           <ValidationSummary />
                           <MudNumericField T="double" Min="0.01" Max="1000" @bind-Value="mGoalBarData.Settings.BitPoints" />
                        </div>
                     }

                     <div class="form-group form-check">
                        <MudCheckBox T="bool" @bind-Value="mGoalBarData.Settings.IncludeTips" Label="Include Streamlabs Tips" />
                        <span id="uiIncludeTips" class="gifbot-field-desc">When enabled, tipping via Streamlabs will count toward the goal (must authenticate with Streamlabs).</span>
                     </div>

                     @if (mGoalBarData.Settings.IncludeTips)
                     {
                        <div class="form-group">
                           <label for="uiTipPointsLabel">Tip Point Amount:</label>
                           <span id="uiTipPointsLabel" class="gifbot-field-desc">The number of points applied to the goal per 1 currency tipped (i.e. $1 = 1 point).</span>
                           <DataAnnotationsValidator />
                           <ValidationSummary />
                           <MudNumericField T="double" Min="0.01" Max="1000" @bind-Value="mGoalBarData.Settings.TipPoints" />
                        </div>
                     }

                     <div class="form-group form-check">
                        <MudCheckBox T="bool" @bind-Value="mGoalBarData.Settings.IncludeSubs" Label="Include Subscriptions" />
                        <span id="uiIncludeSubs" class="gifbot-field-desc">When enabled, subscriptions, resubscriptions, and gift subscriptions count toward the goal.</span>
                     </div>

                     @if (mGoalBarData.Settings.IncludeSubs)
                     {
                        <div class="form-group">
                           <label for="uiSub1PointsLabel">Tier 1 Point Amount:</label>
                           <span id="uiSub1PointsLabel" class="gifbot-field-desc">The number of points applied to the goal tier 1 subscription.</span>
                           <DataAnnotationsValidator />
                           <ValidationSummary />
                           <MudNumericField T="double" Min="0.01" Max="1000" @bind-Value="mGoalBarData.Settings.SubTier1Points" />
                        </div>
                        <div class="form-group">
                           <label for="uiSub2PointsLabel">Tier 2 Point Amount:</label>
                           <span id="uiSub2PointsLabel" class="gifbot-field-desc">The number of points applied to the goal tier 2 subscription.</span>
                           <DataAnnotationsValidator />
                           <ValidationSummary />
                           <MudNumericField T="double" Min="0.01" Max="1000" @bind-Value="mGoalBarData.Settings.SubTier2Points" />
                        </div>
                        <div class="form-group">
                           <label for="uiSub3PointsLabel">Tier 3 Point Amount:</label>
                           <span id="uiSub3PointsLabel" class="gifbot-field-desc">The number of points applied to the goal tier 3 subscription.</span>
                           <DataAnnotationsValidator />
                           <ValidationSummary />
                           <MudNumericField T="double" Min="0.01" Max="1000" @bind-Value="mGoalBarData.Settings.SubTier3Points" />
                        </div>
                     }
                  </MudExpansionPanel>
                  </div>
               </div>
      </MudTabPanel>

      <MudTabPanel Text="Visual Settings">
         <div class="p-0 m-0 rounded gifbot-section-panel">
            <div class="p-2">
               <div class="form-group form-check">
                  <MudCheckBox T="bool" Value="mGoalBarData.Settings.HideGoalText" ValueChanged="@(v => { mGoalBarData.Settings.HideGoalText = v; UpdateCaptionPreview(null); })" Label="Hide Goal Text" />
                  <span id="uiHideGoalText" class="gifbot-field-desc">When enabled, the text for the goal will not be visible on the bar overlay.</span>
               </div>
               <div class="form-group form-check">
                  <MudCheckBox T="bool" Value="mGoalBarData.Settings.ShowAmountAsPercentage" ValueChanged="@(v => { mGoalBarData.Settings.ShowAmountAsPercentage = v; UpdateCaptionPreview(null); })" Label="Show Current Amount as Percentage" />
                  <span id="uiPercentage" class="gifbot-field-desc">When enabled, the current amount on the bar will be shown as a percentage value.</span>
               </div>
               @if (!mGoalBarData.Settings.ShowAmountAsPercentage)
               {
                  <div class="form-group">
                     <label for="uiCurrencyLabel">The currency symbol to use:</label>
                     <MudTextField T="string" @bind-Value="@mGoalBarData.Settings.CurrencySymbol" />
                  </div>
               }
               <div class="form-group mt-2">
                  <label for="uiWidth"><b>Bar Width:</b></label>
                  <span id="uiWidth" class="gifbot-field-desc">The width of the whole goal bar.</span>
                  <MudNumericField T="int" Min="100" Max="9999" @bind-Value="mGoalBarData.Settings.Width" />
               </div>
               <div class="form-group mt-2">
                  <label for="uiBarForeColorLabel"><b>Bar Forecolor:</b></label>
                  <span id="uiBarForeColorLabel" class="gifbot-field-desc">The forecolor for the bar.</span>
                  <input type="color" id="uiBarForeColor" value="@mGoalBarData.Settings.BarForecolor" @onchange="@(e => { mGoalBarData.Settings.BarForecolor = e.Value?.ToString(); UpdateCaptionPreview(null); })" />
               </div>
               <div class="form-group mt-2">
                  <label for="uiBarBackColorLabel"><b>Bar Backcolor:</b></label>
                  <span id="uiBarBackColorLabel" class="gifbot-field-desc">The backcolor for the bar.</span>
                  <input type="color" id="uiBarBackColor" value="@mGoalBarData.Settings.BarBackcolor" @onchange="@(e => { mGoalBarData.Settings.BarBackcolor = e.Value?.ToString(); UpdateCaptionPreview(null); })" />
               </div>
               <div class="form-group mt-2">
                  <label for="uiFontSize"><b>Font Size:</b></label>
                  <span id="uiFontSize" class="gifbot-field-desc">The size of the font used (bigger = better).</span>
                  <MudNumericField T="int" Min="18" Max="100" Value="mGoalBarData.Settings.Caption.FontSize" ValueChanged="@(v => { mGoalBarData.Settings.Caption.FontSize = v; UpdateCaptionPreview(null); })" />
               </div>
               <div class="form-group mt-2">
                  <label for="uiFontColor"><b>Font Color:</b></label>
                  <span id="uiFontColor" class="gifbot-field-desc">The forecolor for the caption text.</span>
                  <input type="color" id="uiFontColor" value="@mGoalBarData.Settings.Caption.FontColor" @onchange="@(e => { mGoalBarData.Settings.Caption.FontColor = e.Value?.ToString(); UpdateCaptionPreview(null); })" />
               </div>
               <div class="form-group mt-2">
                  <label for="uiStrokeThickness"><b>Stroke Thickness:</b></label>
                  <span id="uiStrokeThickness" class="gifbot-field-desc">The width of the stroke (outline) on the caption text.</span>
                  <MudNumericField T="int" Min="0" Max="5" Value="mGoalBarData.Settings.Caption.StrokeThickness" ValueChanged="@(v => { mGoalBarData.Settings.Caption.StrokeThickness = v; UpdateCaptionPreview(null); })" />
               </div>
               <div class="form-group mt-2">
                  <label for="uiFontStrokeColor"><b>Stroke Color:</b></label>
                  <span id="uiFontStrokeColor" class="gifbot-field-desc">The stroke or outline color for the caption text.</span>
                  <input type="color" id="uiFontStrokeColor" value="@mGoalBarData.Settings.Caption.FontStrokeColor" @onchange="@(e => { mGoalBarData.Settings.Caption.FontStrokeColor = e.Value?.ToString(); UpdateCaptionPreview(null); })" />
               </div>
               <div class="form-group mt-2">
                  <label for="uiFont"><b>Font:</b></label>
                  <span id="uiFont" class="gifbot-field-desc">What font should you use?</span>
                  <MudSelect T="int" Value="mCaptionFontSelection" ValueChanged="@OnCaptionFontChange" Label="Font">
                     <MudSelectItem T="int" Value="0">Arial</MudSelectItem>
                     <MudSelectItem T="int" Value="1">Comic Sans</MudSelectItem>
                     <MudSelectItem T="int" Value="2">Impact</MudSelectItem>
                     <MudSelectItem T="int" Value="3">Monospace</MudSelectItem>
                     <MudSelectItem T="int" Value="4">Aldrich</MudSelectItem>
                     <MudSelectItem T="int" Value="5">Anton</MudSelectItem>
                     <MudSelectItem T="int" Value="6">Barrio</MudSelectItem>
                     <MudSelectItem T="int" Value="7">Creepster</MudSelectItem>
                     <MudSelectItem T="int" Value="8">Eater</MudSelectItem>
                     <MudSelectItem T="int" Value="9">Galada</MudSelectItem>
                     <MudSelectItem T="int" Value="10">Ranchers</MudSelectItem>
                     <MudSelectItem T="int" Value="11">Lobster</MudSelectItem>
                     <MudSelectItem T="int" Value="12">Righteous</MudSelectItem>
                     <MudSelectItem T="int" Value="13">BenchNine</MudSelectItem>
                     <MudSelectItem T="int" Value="14">Oswald</MudSelectItem>
                     <MudSelectItem T="int" Value="15">Ultra</MudSelectItem>
                     <MudSelectItem T="int" Value="16">Frijole</MudSelectItem>
                     <MudSelectItem T="int" Value="17">Viga</MudSelectItem>
                     <MudSelectItem T="int" Value="18">Quantico</MudSelectItem>
                     <MudSelectItem T="int" Value="19">Bungee</MudSelectItem>
                     <MudSelectItem T="int" Value="21">Sriracha</MudSelectItem>
                     <MudSelectItem T="int" Value="22">Arsenal</MudSelectItem>
                     <MudSelectItem T="int" Value="23">Gaegu</MudSelectItem>
                     <MudSelectItem T="int" Value="24">VT323</MudSelectItem>
                  </MudSelect>
               </div>
                <div class="form-group mt-2">
                   <label for="uiIsBold"><b>Font Weight:</b></label>
                   <span id="uiIsBold" class="gifbot-field-desc">Would you like the font to be bold?</span>
                   <MudCheckBox T="bool" Value="mGoalBarData.Settings.Caption.IsBold" ValueChanged="@(v => { mGoalBarData.Settings.Caption.IsBold = v; UpdateCaptionPreview(null); })" Label="Bolded Text" />
                </div>
               <div class="mt-2">
                  <label for="uiPreview"><b>Text Preview:</b></label>
                  <div class="d-flex justify-center">
                     <ProgressBarComponent Width="@mGoalBarData.Settings.Width" TitleCaptionData="@mGoalBarData.Settings.Caption" PercentageCaptionData="@mPercentageCaptionData" TotalCaptionData="@mTotalCaptionData" CurrentPercentage="35" BackColor="@mGoalBarData.Settings.BarBackcolor" ProgressColor="@mGoalBarData.Settings.BarForecolor" />
                  </div>
               </div>
            </div>
         </div>
      </MudTabPanel>

      <MudTabPanel Text="Goals">
         <div class="p-0 m-0 rounded gifbot-section-panel">
            <div class="p-2">
               <div class="text-white-50 p-0">
                  <p>
                     You can have more than one goal. When you have satisfied the requirements of one goal, the next goal in the list will
                     be activated. If there is any rollover amount, it will be applied to the next goal as well.
                  </p>
               </div>

               @if (mGoalBarData.Goals.Any() && mGoalBarData.Goals.FirstOrDefault(g => g.IsActive == true) == null)
               {
                  <div class="text-warning p-0">
                     <p>
                        <b>
                           <i>
                              You do not currently have an active goal. You must manually set a goal as active once you are ready to begin
                              raising funds for your sweet, sweet stuff.
                           </i>
                        </b>
                     </p>
                  </div>
               }

               <div class="d-flex justify-end mb-2">
                  <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@ShowAddNewGoalWindow">Add New Goal</MudButton>
               </div>
               <MudTabs ApplyEffectsToContainer="true" Elevation="0" Rounded="true" PanelClass="pa-3">
                  @for (int i = 0; i < mGoalBarData.Goals.Count; ++i)
                  {
                     GoalData goal = mGoalBarData.Goals[i];
                     string title = $"[{i + 1}] {goal.Title}";
                     if (goal.IsActive)
                     {
                        title += " (Active)";
                     }

                     <MudTabPanel Text="@(title)">
                        <GoalComponent Goal="@goal" OnMakeGoalActive="@HandleMakeGoalActive" OnDeleteGoal="@HandleDeleteGoal" />
                     </MudTabPanel>
                  }
               </MudTabs>
            </div>
         </div>
      </MudTabPanel>

      <MudTabPanel Text="BrowserSource URL">
         <div class="p-0 m-0 rounded gifbot-section-panel">
            <div class="p-2">
            <div class="text-white-50 p-0">
               <p>
                  To display the goal bar in your broadcaster software, copy this URL and use it as the input for a new Browser Source element. Note: If you set
                  this browser source to refresh when you switch scenes, the goal bar will flicker since it will rebuild as if you had refreshed in Chrome.
               </p>
            </div>
            <div class="d-flex align-center gap-2">
               <MudTextField T="string" Style="flex: 1" ReadOnly="true" @bind-Value="mURL" />
               <MudButton Variant="Variant.Filled" Class="gifbot-action-btn" OnClick="@(() => HandleCopyUrl(mURL))">Copy to Clipboard</MudButton>
            </div>
            </div>
         </div>
      </MudTabPanel>
   </MudTabs>

          <div class="d-flex justify-end pa-3 gap-4">
          <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@OnCancel">Cancel</MudButton>
          <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">Save Changes</MudButton>
       </div>
      </div>
   </div>
</EditForm>

@code {

   /// <summary>
   /// Keeps track of which tab is selected.
   /// </summary>
   public int ActiveTabIndex { get; set; } = 0;

   protected override async Task OnInitializedAsync()
   {
      // Build the connection to the main bot hub.
      mHubConnection = new HubConnectionBuilder()
         .WithUrl(NavigationManager.ToAbsoluteUri("/gifbothub"), HttpTransportType.LongPolling) 
         .WithAutomaticReconnect()
         .Build();

      mHubConnection.On<string>("GoalBarDataUpdated", async (data) =>
      {
         mGoalBarData = JsonConvert.DeserializeObject<GoalBarData>(data);
         await InvokeAsync(StateHasChanged);
      });

      // Start the connection.
      await mHubConnection.StartAsync();

      // Get the goal bar data.
      await GetGoalBarDataFromHub();

      // Get the goal bar url.
      mURL = await mHubConnection.InvokeAsync<string>("GetGoalBarWebPath");

      // Render.
      StateHasChanged();
   }

   /// <summary>
   /// IAsyncDisposable Implementation
   /// </summary>
   public async ValueTask DisposeAsync()
   {
      await mHubConnection.DisposeAsync();
   }

   private async Task GetGoalBarDataFromHub()
   {
      string rawData = await mHubConnection.InvokeAsync<string>("GetGoalBarData");
      mGoalBarData = JsonConvert.DeserializeObject<GoalBarData>(rawData);
      mCaptionFontSelection = (int)mGoalBarData.Settings.Caption.FontFamily;
      UpdateCaptionPreview(null);
   }

   /// <summary>
   /// Handle a caption font change.
   /// </summary>
   private void OnCaptionFontChange(int value)
   {
      mCaptionFontSelection = value;
      mGoalBarData.Settings.Caption.FontFamily = (global::GIFBot.Shared.Models.Visualization.FontFamily)value;
      UpdateCaptionPreview(null);
   }

   /// <summary>
   /// Handles updating the variables needed for the caption preview.
   /// </summary>
   private void UpdateCaptionPreview(object unused)
   {
      mGoalBarData.Settings.Caption.Text = String.Empty;
      if (!mGoalBarData.Settings.HideGoalText)
      {
         mGoalBarData.Settings.Caption.Text = "Test Goal";
      }

      mPercentageCaptionData = (CaptionData)mGoalBarData.Settings.Caption.Clone();

      if (mGoalBarData.Settings.ShowAmountAsPercentage)
      {
         mPercentageCaptionData.Text = "35%";
      }
      else
      {
         mPercentageCaptionData.Text = $"{mGoalBarData.Settings.CurrencySymbol}345.67";
      }

      mTotalCaptionData = (CaptionData)mGoalBarData.Settings.Caption.Clone();
      mTotalCaptionData.Text = "100";

      StateHasChanged();
   }

   private void ShowAddNewGoalWindow()
   {
      mNewGoalTitle = string.Empty;
      mIsNewGoalPromptVisible = true;
      StateHasChanged();
   }

   private void HandleCancelAddGoal()
   {
      mIsNewGoalPromptVisible = false;
      mNewGoalTitle = string.Empty;
      StateHasChanged();
   }

   private async Task HandleAddNewGoal()
   {
      if (string.IsNullOrWhiteSpace(mNewGoalTitle))
      {
         Snackbar.Add("Error - Please enter a goal title.", Severity.Error);
         return;
      }

      mIsNewGoalPromptVisible = false;

      bool result = await mHubConnection.InvokeAsync<bool>("AddGoal", mNewGoalTitle);
      if (result)
      {
         Snackbar.Add("Success - The new goal was added.", Severity.Success);
         await GetGoalBarDataFromHub();
         await InvokeAsync(() => { StateHasChanged(); });
      }
      else
      {
         Snackbar.Add($"Error - The new goal could not be added. A goal with that title already exists!", Severity.Error);
         await InvokeAsync(() => { StateHasChanged(); });
      }
   }

   private async Task HandleMakeGoalActive(Guid goalId)
   {
      bool result = await mHubConnection.InvokeAsync<bool>("MakeGoalActive", goalId);
      if (result)
      {
         Snackbar.Add("Success - The goal is now active!", Severity.Success);
         await GetGoalBarDataFromHub();
         await InvokeAsync(() => { StateHasChanged(); });
      }
      else
      {
         Snackbar.Add($"Error - The goal could not be activated. Does not exist.", Severity.Error);
         await InvokeAsync(() => { StateHasChanged(); });
      }
   }

   private void HandleDeleteGoal(Guid goalId)
   {
      mPendingDeleteGoalId = goalId;
      mIsDeleteGoalDialogVisible = true;
      StateHasChanged();
   }

   private async Task HandleConfirmDeleteGoal()
   {
      mIsDeleteGoalDialogVisible = false;
      bool result = await mHubConnection.InvokeAsync<bool>("DeleteGoal", mPendingDeleteGoalId);
      if (result)
      {
         Snackbar.Add("Success - The goal was deleted!", Severity.Success);
         await GetGoalBarDataFromHub();
         await InvokeAsync(() => { StateHasChanged(); });
      }
      else
      {
         Snackbar.Add($"Error - The goal could not be deleted. Does not exist.", Severity.Error);
         await InvokeAsync(() => { StateHasChanged(); });
      }
   }

   private async Task HandleDeleteGoal(GoalData goal)
   {
      //await OnVariantDeleted.InvokeAsync(variant.Id);
      await Task.CompletedTask;
   }

   private async Task UpdateGoalHandler(GoalData goal)
   {
      await Task.CompletedTask;
   }

   private void GoalPageChanged(int page)
   {
      mGoalPage = page;
   }

   private async Task HandleCopyUrl(string url)
   {
      try
      {
         await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", url);
         Snackbar.Add("Success - The URL was copied to your clipboard!", Severity.Success);
      }
      catch (Exception)
      {
         Snackbar.Add("Error - Could not copy to clipboard.", Severity.Error);
      }
   }

   private void OnCancel()
   {
      NavigationManager.NavigateTo("/");
   }

   private async Task OnSaveChanges()
   {
      await mHubConnection.InvokeAsync("UpdateGoalBarData", JsonConvert.SerializeObject(mGoalBarData));
      await GetGoalBarDataFromHub();
      Snackbar.Add("Save Successful - The goal bar data has been saved.", Severity.Success);
      await InvokeAsync(() => { StateHasChanged(); });
   }

   private HubConnection mHubConnection;

   private GoalBarData mGoalBarData = new GoalBarData();
   private CaptionData mPercentageCaptionData = new CaptionData();
   private CaptionData mTotalCaptionData = new CaptionData();
   private int mCaptionFontSelection = 0;
   private string mURL = String.Empty;
   private bool mIsNewGoalPromptVisible = false;
   private bool mIsDeleteGoalDialogVisible = false;
   private Guid mPendingDeleteGoalId;

   // Adding Goals Variables
   private string mNewGoalTitle = String.Empty;
   private int mGoalPage = 1;
}
