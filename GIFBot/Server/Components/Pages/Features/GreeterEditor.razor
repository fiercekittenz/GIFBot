@page "/greetereditor/"
@using Microsoft.AspNetCore.SignalR.Client
@using global::GIFBot.Shared.Models.Features
@using global::GIFBot.Shared.Models.Visualization
@using global::GIFBot.Server.Components.UI
@using Newtonsoft.Json
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<div class="pa-1 my-1 gifbot-page-header">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.WavingHand" />
        <MudText Typo="Typo.h4">Greeter</MudText>
    </MudStack>
</div>

<!-- Add New Entry Window -->
<MudDialog @bind-Visible="@mIsAddDialogVisible">
    <TitleContent>
        <MudText Typo="Typo.h6">Add New Greeter Entry</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle1"><b>Greeter Name</b></MudText>
        <MudText Typo="Typo.caption" Class="text-white-50 mb-2">Enter a descriptive name for this greeter entry. This is for your reference only.</MudText>
        <MudTextField T="string" @bind-Value="mTempGreeterEntry.Name" Placeholder="Enter greeter name..." />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@HandleCancelAddCommand">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="@HandleConfirmAddCommand">Add</MudButton>
    </DialogActions>
</MudDialog>

<!-- Edit Entry Window -->
<MudDialog @bind-Visible="@mIsEditDialogVisible">
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Greeter: @mTempGreeterEntry.Name</MudText>
    </TitleContent>
    <DialogContent>
        <div class="form-group form-check">
            <MudCheckBox T="bool" @bind-Value="mTempGreeterEntry.Enabled" Label="Enabled" />
            <small id="uiTempEntryEnabled" class="form-text text-muted">When enabled, this greeter active.</small>
        </div>
        <div class="form-group">
            <MudText Typo="Typo.subtitle1"><b>Name</b></MudText>
            <MudText Typo="Typo.caption" Class="text-white-50 mb-2">The name to identify this greeter.</MudText>
            <MudTextField T="string" @bind-Value="mTempGreeterEntry.Name" />
        </div>
        <div class="form-group">
            <MudText Typo="Typo.subtitle1"><b>Animation</b></MudText>
            <MudText Typo="Typo.caption" Class="text-white-50 mb-2">Play an animation when a viewer in this greeter's recipient list speaks in chat. You may want to make sure this animation is BOT ONLY so it can't be triggered by anything but this greeter.</MudText>
            <AnimationSelectorComponent Animations="@AnimationOptions" SelectedAnimation="mTempGreeterEntry.AnimationId" OnSelectedAnimationChanged="@HandleAnimationSelectionChanged" />
        </div>
        <div class="form-group">
            <MudText Typo="Typo.subtitle1"><b>Phrase Sent to Chat</b></MudText>
            <MudText Typo="Typo.caption" Class="text-white-50 mb-2">The bot will send this to chat in addition to any animation. Use $user to display who was greeted! (e.g. "!so $user")</MudText>
            <MudTextField T="string" @bind-Value="mTempGreeterEntry.ChatMessage" />
        </div>
        <div class="form-group">
            <MudList T="string">
                @* TODO: Greeter recipients list - needs MudBlazor-compatible implementation *@
            </MudList>
        </div>

         <div class="form-group">
            <label for="uiImport">Bulk Import Recipients from Text File:</label>
            <small id="uiImport" class="form-text text-muted">
               You can import directly from a text file. Each entry should be on its own line in the text file.
            </small>
            @* TODO: Wire up file upload handler *@
<InputFile accept="text/*" style="width: 100%; background-color: #16162e" />
            @if (mUploadProgress > 0)
            {
                <MudProgressLinear Value="@mUploadProgress" Style="margin-bottom: 20px; width: 100%" />
            }
            @if (!String.IsNullOrEmpty(mUploadErrorMessage))
            {
               <label class="text-danger">@mUploadErrorMessage</label>
            }
         </div>

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@HandleCancelEditCommand">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="@HandleConfirmEditCommand">Save</MudButton>
    </DialogActions>
</MudDialog>

<MudTabs @bind-ActivePanelIndex="@ActiveTabIndex" ApplyEffectsToContainer="true" Elevation="0" Rounded="true" PanelClass="pa-3">
    <MudTabPanel Text="Greeters">
        <div class="p-2">
            <MudDataGrid T="GreeterEntry" Items="@Data.Entries" SortMode="SortMode.Single">
               <ToolBarContent>
                  <MudTextField T="string" Placeholder="Search..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                  <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@HandleAddRequest">Add New Greeter</MudButton>
               </ToolBarContent>
                <Columns>
                    <PropertyColumn T="GreeterEntry" TProperty="string" Property="@(x => x.Name)" Title="Greeter Name" />
                    <TemplateColumn Title="Recipients">
<CellTemplate Context="data">
                            @((data.Item).GetRecipientsDisplayList())
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn>
<CellTemplate Context="data">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="gifbot-neutral-btn" OnClick="@(() => HandleEditRequest((data.Item)))" Title="Edit" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="gifbot-neutral-btn" OnClick="@(() => HandleDeleteRequest((data.Item)))" Title="Delete" />
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
            </MudDataGrid>
        </div>
    </MudTabPanel>
</MudTabs>

