@page "/backdropeditor/"
@using Microsoft.AspNetCore.SignalR.Client
@using global::GIFBot.Shared.Models.Features
@using global::GIFBot.Shared.Models.Visualization
@using global::GIFBot.Server.Components.UI
@using Newtonsoft.Json
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<div class="pa-1 my-1 gifbot-page-header">
   <MudText Typo="Typo.h4"><span class="oi oi-image" aria-hidden="true"></span> Backdrop</MudText>
</div>

<!-- Add New Backdrop Window -->
<MudDialog @bind-Visible="@mIsAddDialogVisible">
   <TitleContent>
      <MudText Typo="Typo.h6">Add New Backdrop</MudText>
   </TitleContent>
   <DialogContent>
      <MudText Typo="Typo.subtitle1"><b>Backdrop Name</b></MudText>
      <MudText Typo="Typo.caption" Class="text-white-50 mb-2">Enter a name for the new backdrop.</MudText>
      <MudTextField T="string" @bind-Value="mTempData.Name" Placeholder="Enter backdrop name..." />
   </DialogContent>
   <DialogActions>
      <MudButton OnClick="@HandleCancelAddCommand">Cancel</MudButton>
      <MudButton Color="Color.Primary" OnClick="@HandleConfirmAddCommand">Add</MudButton>
   </DialogActions>
</MudDialog>

<!-- Edit Window -->
<MudDialog @bind-Visible="@mIsEditDialogVisible">
   <TitleContent>
      <MudText Typo="Typo.h6">Edit Backdrop: @mTempData.Name</MudText>
   </TitleContent>
   <DialogContent>
      <div class="form-group form-check">
         <label class="form-check-label">
            <MudCheckBox T="bool" @bind-Value="mTempData.Enabled" /> Enabled
            <small id="uiTempCommandEnabled" class="form-text text-muted">When enabled, this backdrop is available for use by viewers.</small>
         </label>
      </div>
      <div class="form-group">
         <MudText Typo="Typo.subtitle1"><b>Name</b></MudText>
         <MudText Typo="Typo.caption" Class="text-white-50 mb-2">The name to identify this backdrop. When executed in chat, users must cheer. If this is in a channel point reward, the backdrop name and Backdrop feature command needs to be in the title of the reward.</MudText>
         <MudTextField T="string" @bind-Value="mTempData.Name" />
      </div>
      <div class="form-group">
         <MudText Typo="Typo.subtitle1"><b>Backdrop Visual</b></MudText>
         <MudText Typo="Typo.caption" Class="text-white-50 mb-2">The visual file displayed with this backdrop. Note the backdrop will take the full 1080p resolution. If it isn't that size, it will be stretched to fit!</MudText>
         <table>
            <tr>
               <td valign="top">
                  <MudTextField T="string" Disabled="true" @bind-Value="mTempData.Visual" />
                  @* TODO: Wire up file upload handler *@
<InputFile accept="image/gif,image/jpeg,image/png,video/mp4,video/webm,video/mov" style="width: 100%; background-color: #16162e" />
                  @if (mUploadVisualProgress > 0)
                  {
                      <MudProgressLinear Value="@mUploadVisualProgress" Style="margin-bottom: 20px; width: 100%" />
                  }
                  @if (!String.IsNullOrEmpty(mUploadVisualErrorMessage))
                  {
                     <label class="text-danger">@mUploadVisualErrorMessage</label>
                  }
               </td>
            </tr>
         </table>
      </div>
   </DialogContent>
   <DialogActions>
      <MudButton OnClick="@HandleCancelEditCommand">Cancel</MudButton>
      <MudButton Color="Color.Primary" OnClick="@HandleConfirmEditCommand">Save</MudButton>
   </DialogActions>
</MudDialog>

<MudTabs @bind-ActivePanelIndex="@ActiveTabIndex" ApplyEffectsToContainer="true" Elevation="0" Rounded="true" PanelClass="pa-3">
   <MudTabPanel Text="General">
               <div class="d-flex justify-end pa-3">
            <button type="reset" class="btn btn-secondary p-2 gifbot-secondary-btn" @onclick="@OnTakeDownBackdrop">Take Down Active Backdrop</button>
            <button type="reset" class="btn btn-secondary p-2 gifbot-secondary-btn" @onclick="@OnCancel">Cancel</button>
            <button type="submit" class="btn btn-primary p-2 gifbot-primary-btn" @onclick="@OnSaveChanges">Save Changes</button>
         </div>

      <div class="p-2">
         The Backdrop allows your community to control what is behind you or ON you if you're leveraging chroma key features in your content. Provide a
         variety of backdrops and give your community the tools to change your backdrop via tips, charitable donations, channel points, or cheers! Backdrops need
         to be 1080p. If not, they will be stretched to that size. Default behavior is to randomly choose one of the backdrops on command execution. The command
         usage may include the name of a backdrop to specifically choose that one!
      </div>

      <div class="p-2">
         <div class="form-group form-check">
            <label class="form-check-label">
               <MudCheckBox T="bool" @bind-Value="Data.Enabled" /> Feature Enabled
               <small id="uiEnabled" class="form-text text-muted">When enabled, this feature is active and available to your users!</small>
            </label>
         </div>
      </div>
      <div class="form-group">
         <label for="uiCommandLbl"><b>Title (or Command if used in chat):</b></label>
         <small id="uiCommandLbl" class="form-text text-white-50">How should the bot look for this feature being activated? You can give it a title and mirror it in your channel points, or a ! command for chat!</small>
         <MudTextField T="string" @bind-Value="Data.Command" />
      </div>
      <div class="form-group">
         <label for="uiCommandRedemption">Redemption Type:</label>
         <small id="uiCommandRedemption" class="form-text text-muted">Backdrops can be changed from a variety of methods. If using chat, you need to use the command otherwise the system won't recognize it as a deliberate backdrop change. Example chat usage: !backdrop cheer100</small>
         <MudRadioGroup @bind-Value="@CurrentlyEditedRedemption" T="int">
<MudRadio T="int" Value="@(0)">Cheer</MudRadio>
               <MudRadio T="int" Value="@(1)">Channel Points</MudRadio>
               <MudRadio T="int" Value="@(2)">Tiltify Donation</MudRadio>
               <MudRadio T="int" Value="@(3)">Tip</MudRadio>
</MudRadioGroup>
      </div>
      <div class="form-group">
         <label for="uiCommandCostLbl">Cost:</label>
         <small id="uiCommandCostLbl" class="form-text text-muted">The number of bits, channel points, etc. required to execute this command.</small>
         <MudNumericField T="int" Min="1" Max="999999" @bind-Value="Data.Cost" />
      </div>
      <div class="form-group">
         <label for="uiCommandMinMinutesLbl">Minimum Minutes Active:</label>
         <small id="uiCommandMinMinutesLbl" class="form-text text-muted">The number of minutes that an active backdrop should remain visible even if there are queued backdrops. Ensures viewers get their "cost's" worth at the very least.</small>
         <MudNumericField T="int" Min="1" Max="999999" @bind-Value="Data.MinimumMinutesActive" />
      </div>

               <div class="d-flex justify-end pa-3">
            <button type="reset" class="btn btn-secondary p-2 gifbot-secondary-btn" @onclick="@OnCancel">Cancel</button>
            <button type="submit" class="btn btn-primary p-2 gifbot-primary-btn" @onclick="@OnSaveChanges">Save Changes</button>
         </div>
   </MudTabPanel>

   <MudTabPanel Text="Backdrops">
      <div class="p-2">
         <MudDataGrid T="BackdropVideoEntryData" Items="@Data.Backdrops" SortMode="SortMode.Single">
            <ToolBarContent>
               <MudTextField T="string" Placeholder="Search..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
               <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@HandleAddRequest">Add Backdrop</MudButton>
            </ToolBarContent>
            <Columns>
               <PropertyColumn T="BackdropVideoEntryData" TProperty="string" Property="@(x => x.Name)" Title="Value" />
               <TemplateColumn Title="">
<CellTemplate Context="data">
                     <button type="button" class="btn btn-secondary p-0 m-0 gifbot-secondary-btn" style="width: 25px; height: 25px" @onclick="(() => HandleHangRequest((data.Item)))"><span class="oi oi-play-circle"></span></button>
                     <button type="button" class="btn btn-secondary p-0 m-0 gifbot-secondary-btn" style="width: 25px; height: 25px" @onclick="(() => HandleEditRequest((data.Item)))"><span class="oi oi-pencil"></span></button>
                     <button type="button" class="btn btn-secondary p-0 m-0 gifbot-secondary-btn" style="width: 25px; height: 25px" @onclick="(() => HandleDeleteRequest((data.Item)))"><span class="oi oi-trash"></span></button>
                  </CellTemplate>
               </TemplateColumn>
            </Columns>
         </MudDataGrid>
      </div>
   </MudTabPanel>

   <MudTabPanel Text="Browsersource URL">
      <div class="p-0 m-0 rounded gifbot-section-panel">
         <div class="p-2">
            <p class="text-white-50">
               Below is the URL you will need to capture in your broadcaster software in order to see the Backdrops on your scenes.
            </p>
            <p class="text-white-50">
               <u>Note:</u> If you are using XSplit, you will need to add these as Media sources, not Browser sources. These are files installed by GIFBot and not hosted on a web server.
            </p>
            <div>
               <table width="100%">
                  <tr>
                     <td width="600">
                        <MudTextField T="string" class="form-control" Style="width: 100%" ReadOnly="true" @bind-Value="WebPath" />
                     </td>
                     <td align="left">
                        <button type="button" class="btn btn-secondary p-1 ml-2 gifbot-secondary-btn" @onclick='(() => HandleCopyUrl("uiURL"))'>Copy to Clipboard</button>
                     </td>
                  </tr>
               </table>
            </div>
         </div>
      </div>
   </MudTabPanel>
</MudTabs>