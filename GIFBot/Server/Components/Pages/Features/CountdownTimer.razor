@page "/countdowneditor/"
@using Microsoft.AspNetCore.SignalR.Client
@using global::GIFBot.Shared.Models.Features
@using global::GIFBot.Shared.Models.Visualization
@using global::GIFBot.Server.Components.UI
@using Newtonsoft.Json
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<div class="pa-1 my-1 gifbot-page-header">
   <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
      <MudIcon Icon="@Icons.Material.Filled.Timer" />
      <MudText Typo="Typo.h4">Countdown</MudText>
   </MudStack>
</div>

<!-- Add New Action Window -->
<MudDialog @bind-Visible="@mIsAddDialogVisible">
   <TitleContent>
      <MudText Typo="Typo.h6">Add New Action</MudText>
   </TitleContent>
   <DialogContent>
      <MudText Typo="Typo.subtitle1"><b>Action Name</b></MudText>
      <MudText Typo="Typo.caption" Class="text-white-50 mb-2">Enter a name for the new countdown timer action.</MudText>
      <MudTextField T="string" @bind-Value="mTempData.Name" Placeholder="Enter action name..." />
   </DialogContent>
   <DialogActions>
      <MudButton OnClick="@HandleCancelAddCommand">Cancel</MudButton>
      <MudButton Color="Color.Primary" OnClick="@HandleConfirmAddCommand">Add</MudButton>
   </DialogActions>
</MudDialog>

<!-- Edit Window -->
<MudDialog @bind-Visible="@mIsEditDialogVisible">
   <TitleContent>
      <MudText Typo="Typo.h6">Edit Action: @mTempData.Name</MudText>
   </TitleContent>
   <DialogContent>
      <div class="form-group form-check">
         <MudCheckBox T="bool" @bind-Value="mTempData.Enabled" Label="Enabled" />
         <small id="uiTempCommandEnabled" class="form-text text-muted">When enabled, this action is available for use.</small>
      </div>
      <div class="form-group">
         <MudText Typo="Typo.subtitle1"><b>Name</b></MudText>
         <MudText Typo="Typo.caption" Class="text-white-50 mb-2">The name to identify this action.</MudText>
         <MudTextField T="string" @bind-Value="mTempData.Name" />
      </div>
      <div class="form-group">
         <MudText Typo="Typo.subtitle1"><b>Animation to Play</b></MudText>
         <MudText Typo="Typo.caption" Class="text-white-50 mb-2">The animation command to play along with this action.</MudText>
         <MudTextField T="string" @bind-Value="mTempData.Animation" />
      </div>
      <div class="form-group">
         <label for="uiCommandRedemption">Redemption Type:</label>
         <small id="uiCommandRedemption" class="form-text text-muted">Actions can be triggered by your viewers using a variety of methods.</small>
         <MudRadioGroup @bind-Value="@CurrentlyEditedRedemption" T="int">
<MudRadio T="int" Value="@(0)">Cheer</MudRadio>
               <MudRadio T="int" Value="@(1)">Channel Points</MudRadio>
               <MudRadio T="int" Value="@(2)">Tiltify Donation</MudRadio>
               <MudRadio T="int" Value="@(3)">Tip</MudRadio>
               <MudRadio T="int" Value="@(4)">Subscription</MudRadio>
</MudRadioGroup>
      </div>

      @if (mTempData.RedemptionType == global::GIFBot.Shared.Utility.Enumerations.CostRedemptionType.Subscription)
      {
         <div class="form-group">
            <MudText Typo="Typo.subtitle1"><b>Subscription Tier</b></MudText>
            <MudText Typo="Typo.caption" Class="text-white-50 mb-2">What sub tier is this action for?</MudText>
            <MudRadioGroup @bind-Value="SubTierSelection" T="int">
<MudRadio T="int" Value="@(0)">All</MudRadio>
                  <MudRadio T="int" Value="@(1)">Prime</MudRadio>
                  <MudRadio T="int" Value="@(2)">Tier 1</MudRadio>
                  <MudRadio T="int" Value="@(3)">Tier 2</MudRadio>
                  <MudRadio T="int" Value="@(4)">Tier 3</MudRadio>
</MudRadioGroup>
         </div>
      }
      else
      {
         <div class="form-group">
            <MudText Typo="Typo.subtitle1"><b>Cost</b></MudText>
            <MudText Typo="Typo.caption" Class="text-white-50 mb-2">The number of bits, channel points, etc. required to trigger this action. Must be an exact value!</MudText>
            <MudNumericField T="double" Min="0.01" Max="999999" @bind-Value="@mTempData.Cost" />
         </div>
      }

      <div class="form-group">
         <MudText Typo="Typo.subtitle1"><b>Action Behavior</b></MudText>
         <MudText Typo="Typo.caption" Class="text-white-50 mb-2">How does this action behave?</MudText>
         <MudRadioGroup @bind-Value="@CurrentlyEditedBehavior" T="int">
<MudRadio T="int" Value="@(0)">Remove Time</MudRadio>
               <MudRadio T="int" Value="@(1)">Add Time</MudRadio>
               <MudRadio T="int" Value="@(2)">Slowdown Time</MudRadio>
               <MudRadio T="int" Value="@(3)">Speed Up Time</MudRadio>
               <MudRadio T="int" Value="@(4)">Pause Time</MudRadio>
</MudRadioGroup>
      </div>
      @if (mTempData.Behavior == CountdownTimerActionBehavior.AddTime || mTempData.Behavior == CountdownTimerActionBehavior.RemoveTime)
      {
         <div class="form-group">
            <MudText Typo="Typo.subtitle1"><b>Adjustment Value</b></MudText>
            <MudText Typo="Typo.caption" Class="text-white-50 mb-2">The number of seconds by which the time is adjusted on Add and Remove time behaviors.</MudText>
            <MudNumericField T="int" Min="1" Max="999999" @bind-Value="@mTempData.SecondsValue" />
         </div>
      }
      else if (mTempData.Behavior == CountdownTimerActionBehavior.PauseTime)
      {
         <div class="form-group">
            <MudText Typo="Typo.subtitle1"><b>Pause Time</b></MudText>
            <MudText Typo="Typo.caption" Class="text-white-50 mb-2">The number of seconds to pause the countdown timer.</MudText>
            <MudNumericField T="int" Min="1" Max="999999" @bind-Value="@mTempData.SecondsValue" />
         </div>
      }
      else if (mTempData.Behavior == CountdownTimerActionBehavior.SlowTime || mTempData.Behavior == CountdownTimerActionBehavior.SpeedUpTime)
      {
         <div class="form-group">
            <MudText Typo="Typo.subtitle1"><b>Speed Modification Preset</b></MudText>
            <MudText Typo="Typo.caption" Class="text-white-50 mb-2">How fast or slow do you want the timer to tick?</MudText>
            <MudRadioGroup @bind-Value="@CurrentlyEditedSpeedPreset" T="int">
@if (mTempData.Behavior == CountdownTimerActionBehavior.SlowTime)
                  {
                     <MudRadio T="int" Value="@(0)">Sloth</MudRadio>
                     <MudRadio T="int" Value="@(1)">Slug</MudRadio>
                     <MudRadio T="int" Value="@(2)">Turtle</MudRadio>
                  }
                  else if (mTempData.Behavior == CountdownTimerActionBehavior.SpeedUpTime)
                  {
                     <MudRadio T="int" Value="@(3)">Rabbit</MudRadio>
                     <MudRadio T="int" Value="@(4)">Ostrich</MudRadio>
                     <MudRadio T="int" Value="@(5)">Sonic</MudRadio>
                  }
</MudRadioGroup>
         </div>
         <div class="form-group">
            <MudText Typo="Typo.subtitle1"><b>Number of Seconds to Modify</b></MudText>
            <MudText Typo="Typo.caption" Class="text-white-50 mb-2">The number of seconds by which the speed at which the time ticks down will be modified.</MudText>
            <MudNumericField T="int" Min="1" Max="999999" @bind-Value="@mTempData.SecondsValue" />
         </div>
      }
   </DialogContent>
   <DialogActions>
      <MudButton OnClick="@HandleCancelEditCommand">Cancel</MudButton>
      <MudButton Color="Color.Primary" OnClick="@HandleConfirmEditCommand">Save</MudButton>
   </DialogActions>
</MudDialog>

<MudTabs @bind-ActivePanelIndex="@ActiveTabIndex" ApplyEffectsToContainer="true" Elevation="0" Rounded="true" PanelClass="pa-3">
   <MudTabPanel Text="General">
      <div class="p-2 mb-2 rounded gifbot-content-panel">
         <div class="text-left" style="width: 100%">
            <MudButton Variant="Variant.Filled" Class="gifbot-action-btn p-1" Style="margin-left: auto; margin-right: 0" OnClick="@OnStartTimer">Start Timer</MudButton>
            <MudButton Variant="Variant.Filled" Class="gifbot-action-btn p-1" Style="margin-left: auto; margin-right: 0" OnClick="@OnPauseTimer">Pause Timer</MudButton>
            <MudButton Variant="Variant.Filled" Class="gifbot-action-btn p-1" Style="margin-left: auto; margin-right: 0" OnClick="@OnResetTimer">Reset Timer</MudButton>
            <MudButton Variant="Variant.Filled" Class="gifbot-action-btn p-1" Style="margin-left: auto; margin-right: 0" OnClick="@OnHideTimer">Hide Timer</MudButton>
         </div>
      </div>

      <div class="p-2">
         The countdown timer feature will allow you to have a timer on your broadcast software scene that the viewers may manipulate through actions. Actions are
         optional, but chaotic fun!
      </div>

      <div class="p-2">
         <div class="form-group form-check">
            <MudCheckBox T="bool" @bind-Value="Data.Enabled" Label="Feature Enabled" />
            <small id="uiEnabled" class="form-text text-muted">When enabled, this feature is active and available to your users!</small>
         </div>
      </div>
      <div class="form-group">
         <label for="uiTimerValueInMinutes">Timer Start Value (in minutes):</label>
         <small id="uiTimerValueInMinutes" class="form-text text-muted">The number of minutes you want this countdown timer to tick.</small>
         <MudNumericField T="int" Min="1" Max="999999" @bind-Value="Data.TimerStartValueInMinutes" />
      </div>
               <div class="d-flex justify-end pa-3 gap-4">
            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@OnCancel">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@OnSaveChanges">Save Changes</MudButton>
         </div>
   </MudTabPanel>

   <MudTabPanel Text="Timer Actions">
      <div class="p-2">
         <MudDataGrid T="CountdownTimerAction" Items="@Data.Actions" SortMode="SortMode.Single">
            <ToolBarContent>
               <MudTextField T="string" Placeholder="Search..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
               <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@HandleAddRequest">Add Action</MudButton>
            </ToolBarContent>
            <Columns>
               <PropertyColumn T="CountdownTimerAction" TProperty="string" Property="@(x => x.Name)" Title="Value" />
               <TemplateColumn Title="">
<CellTemplate Context="data">
                     <MudIconButton Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Small" Class="gifbot-neutral-btn" OnClick="(() => HandlePlayActionRequest((data.Item)))" title="Play" />
                     <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="gifbot-neutral-btn" OnClick="(() => HandleEditRequest((data.Item)))" title="Edit" />
                     <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="gifbot-neutral-btn" OnClick="(() => HandleDeleteRequest((data.Item)))" title="Delete" />
                  </CellTemplate>
               </TemplateColumn>
            </Columns>
         </MudDataGrid>
      </div>
   </MudTabPanel>

   <MudTabPanel Text="Appearance">
      <div class="p-0 m-0 rounded gifbot-section-panel">
         <div class="p-2">
            <div class="form-group mt-2">
               <label for="uiCaptionFontSize"><b>Font Size:</b></label>
               <small id="uiCaptionFontSize" class="form-text text-white-50">The size of the font used (bigger = better).</small>
               <MudNumericField T="int" Min="18" Max="100" @bind-Value="Data.Caption.FontSize" />
            </div>
            <div class="form-group mt-2">
               <label for="uiCaptionFontColor"><b>Font Color:</b></label>
               <small id="uiCaptionFontColor" class="form-text text-white-50">The forecolor for the text.</small>
               <input type="color" id="uiCaptionFontColor" @bind="@Data.Caption.FontColor" />
            </div>
            <div class="form-group mt-2">
               <label for="uiCaptionStrokeThickness"><b>Stroke Thickness:</b></label>
               <small id="uiCaptionStrokeThickness" class="form-text text-white-50">The width of the stroke (outline) on the text.</small>
               <MudNumericField T="int" Min="0" Max="5" @bind-Value="Data.Caption.StrokeThickness" />
            </div>
            <div class="form-group mt-2">
               <label for="uiCaptionFontStrokeColor"><b>Stroke Color:</b></label>
               <small id="uiCaptionFontStrokeColor" class="form-text text-white-50">The stroke or outline color for the text.</small>
               <input type="color" id="uiCaptionFontStrokeColor" @bind="@Data.Caption.FontStrokeColor" />
            </div>
            <div class="form-group mt-2">
               <label for="uiCaptionFont"><b>Font:</b></label>
               <small id="uiCaptionFont" class="form-text text-white-50">What font should you use?</small>
               <MudSelect T="int" @bind-Value="mCaptionFontSelection" Label="Font" Variant="Variant.Filled">
                  <MudSelectItem T="int" Value="0">Arial</MudSelectItem>
                  <MudSelectItem T="int" Value="1">Comic Sans</MudSelectItem>
                  <MudSelectItem T="int" Value="2">Impact</MudSelectItem>
                  <MudSelectItem T="int" Value="3">Monospace</MudSelectItem>
                  <MudSelectItem T="int" Value="4">Aldrich</MudSelectItem>
                  <MudSelectItem T="int" Value="5">Anton</MudSelectItem>
                  <MudSelectItem T="int" Value="6">Barrio</MudSelectItem>
                  <MudSelectItem T="int" Value="7">Creepster</MudSelectItem>
                  <MudSelectItem T="int" Value="8">Eater</MudSelectItem>
                  <MudSelectItem T="int" Value="9">Galada</MudSelectItem>
                  <MudSelectItem T="int" Value="10">Ranchers</MudSelectItem>
                  <MudSelectItem T="int" Value="11">Lobster</MudSelectItem>
                  <MudSelectItem T="int" Value="12">Righteous</MudSelectItem>
                  <MudSelectItem T="int" Value="13">BenchNine</MudSelectItem>
                  <MudSelectItem T="int" Value="14">Oswald</MudSelectItem>
                  <MudSelectItem T="int" Value="15">Ultra</MudSelectItem>
                  <MudSelectItem T="int" Value="16">Frijole</MudSelectItem>
                  <MudSelectItem T="int" Value="17">Viga</MudSelectItem>
                  <MudSelectItem T="int" Value="18">Quantico</MudSelectItem>
                  <MudSelectItem T="int" Value="19">Bungee</MudSelectItem>
                  <MudSelectItem T="int" Value="21">Sriracha</MudSelectItem>
                  <MudSelectItem T="int" Value="22">Arsenal</MudSelectItem>
                  <MudSelectItem T="int" Value="23">Gaegu</MudSelectItem>
                  <MudSelectItem T="int" Value="24">VT323</MudSelectItem>
               </MudSelect>
            </div>
            <div class="form-group mt-2">
               <label for="uiCaptionIsBold"><b>Font Weight:</b></label>
               <small id="uiCaptionIsBold" class="form-text text-white-50">Would you like the font to be bold?</small>
               <MudCheckBox T="bool" @bind-Value="Data.Caption.IsBold" Label="Bolded Text" />
            </div>
            <div class="mt-2">
               <label for="uiCaptionPreview"><b>Preview:</b></label>
               <center>
                  <div class="border-info" style="max-width: 600px; border: inset; border-color: #343434">
                     <div class="p-2">
                        <CaptionComponent CaptionData="@Data.Caption" Width="600" Triggerer="Viewer" Target="Target" />
                     </div>
                  </div>
               </center>
            </div>
         </div>
      </div>
   </MudTabPanel>

   <MudTabPanel Text="Browsersource URL">
      <div class="p-0 m-0 rounded gifbot-section-panel">
         <div class="p-2">
            <p class="text-white-50">
               Below is the URL you will need to capture in your broadcaster software in order to see the Countdown on your scenes.
            </p>
            <p class="text-white-50">
               <u>Note:</u> If you are using XSplit, you will need to add these as Media sources, not Browser sources. These are files installed by GIFBot and not hosted on a web server.
            </p>
            <div>
               <table width="100%">
                  <tr>
                     <td width="600">
                        <MudTextField T="string" class="form-control" Style="width: 100%" ReadOnly="true" @bind-Value="WebPath" />
                     </td>
                     <td align="left">
                        <MudButton Variant="Variant.Filled" Class="gifbot-action-btn p-1 ml-2" OnClick='(() => HandleCopyUrl("uiURL"))'>Copy to Clipboard</MudButton>
                     </td>
                  </tr>
               </table>
            </div>
         </div>
      </div>
   </MudTabPanel>
</MudTabs>
