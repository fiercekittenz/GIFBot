@page "/stickerseditor/"
@using Microsoft.AspNetCore.SignalR.Client
@using global::GIFBot.Shared.Models.Features
@using global::GIFBot.Shared.Models.Visualization
@using global::GIFBot.Server.Components.UI
@using Newtonsoft.Json
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<div class="pa-1 my-1 gifbot-page-header">
   <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
      <MudIcon Icon="@Icons.Material.Filled.EmojiEmotions" />
      <MudText Typo="Typo.h4">Stickers</MudText>
   </MudStack>
</div>

<!-- Delete Sticker/Category Confirmation Dialog -->
<MudDialog @bind-Visible="@mIsDeleteStickerDialogVisible">
   <TitleContent>
      <MudText Typo="Typo.h6">Confirm Delete</MudText>
   </TitleContent>
   <DialogContent>
      <MudText>Are you sure you want to delete <b>@(mPendingDeleteStickerItem?.Name ?? "this item")</b>?</MudText>
   </DialogContent>
   <DialogActions>
      <MudButton OnClick="@(() => mIsDeleteStickerDialogVisible = false)">Cancel</MudButton>
      <MudButton Color="Color.Error" OnClick="@HandleConfirmDeleteSticker">Delete</MudButton>
   </DialogActions>
</MudDialog>

<!-- Delete Selected Stickers Confirmation Dialog -->
<MudDialog @bind-Visible="@mIsDeleteSelectedDialogVisible">
   <TitleContent>
      <MudText Typo="Typo.h6">Confirm Delete</MudText>
   </TitleContent>
   <DialogContent>
      <MudText>Are you sure you want to delete <b>@mSelectedTreeItems.Count(t => t.Type == StickerTreeListItem.ItemType.Entry)</b> selected sticker(s)?</MudText>
   </DialogContent>
   <DialogActions>
      <MudButton OnClick="@(() => mIsDeleteSelectedDialogVisible = false)">Cancel</MudButton>
      <MudButton Color="Color.Error" OnClick="@HandleConfirmDeleteSelected">Delete</MudButton>
   </DialogActions>
</MudDialog>

<!-- Add New Category Window -->
<MudDialog @bind-Visible="@mIsCreateCategoryDialogVisible">
   <TitleContent>
      <MudText Typo="Typo.h6">Add New Category</MudText>
   </TitleContent>
   <DialogContent>
      <MudText Typo="Typo.subtitle1"><b>Category Name</b></MudText>
      <MudText Typo="Typo.caption" Class="text-white-50 mb-2">Enter a unique name for the new sticker category.</MudText>
      <MudTextField T="string" @bind-Value="mTempCategory.Name" Placeholder="Enter category name..." />
   </DialogContent>
   <DialogActions>
      <MudButton OnClick="@HandleCancelAddCategory">Cancel</MudButton>
      <MudButton Color="Color.Primary" OnClick="@HandleConfirmAddCategory">Add</MudButton>
   </DialogActions>
</MudDialog>

<!-- Edit Category Window -->
<MudDialog @bind-Visible="@mIsEditCategoryDialogVisible">
   <TitleContent>
      <MudText Typo="Typo.h6">Edit Category</MudText>
   </TitleContent>
   <DialogContent>
      <MudText Typo="Typo.subtitle1"><b>Category Name</b></MudText>
      <MudText Typo="Typo.caption" Class="text-white-50 mb-2">Update the name of this sticker category. If channel point rewards use this category, update those too.</MudText>
      <MudTextField T="string" @bind-Value="mTempCategory.Name" Placeholder="Enter category name..." />
   </DialogContent>
   <DialogActions>
      <MudButton OnClick="@HandleCancelEditCategory">Cancel</MudButton>
      <MudButton Color="Color.Primary" OnClick="@HandleConfirmEditCategory">Update</MudButton>
   </DialogActions>
</MudDialog>

<!-- Move Sticker Categories Window -->
<MudDialog @bind-Visible="@mIsMoveCategoryDialogVisible">
   <TitleContent>
      <MudText Typo="Typo.h6">Change Category</MudText>
   </TitleContent>
   <DialogContent>
      <MudText Typo="Typo.subtitle1"><b>Target Category</b></MudText>
      <MudText Typo="Typo.caption" Class="text-white-50 mb-2">Choose the new category for the selected stickers.</MudText>
      <MudSelect T="Guid" Placeholder="Select Category..." @bind-Value="@mTempStickerCategoryId">
          @if (mStickerData?.Categories != null)
          {
              @foreach (var cat in mStickerData.Categories)
              {
                  <MudSelectItem T="Guid" Value="@cat.Id">@cat.Name</MudSelectItem>
              }
          }
      </MudSelect>
   </DialogContent>
   <DialogActions>
      <MudButton OnClick="@HandleCancelMoveCategory">Cancel</MudButton>
      <MudButton Color="Color.Primary" OnClick="@HandleConfirmMoveCategory">Update</MudButton>
   </DialogActions>
</MudDialog>

<!-- Edit Placement Window (placement editing window) -->
<MudDialog @bind-Visible="@mIsPlacementBeingEdited">
   <TitleContent>
      <MudText Typo="Typo.h6">Edit Sticker</MudText>
   </TitleContent>
   <DialogContent>
      <MudTabs ApplyEffectsToContainer="true" Elevation="0" Rounded="true" PanelClass="pa-3">
         <MudTabPanel Text="Required Data">
            <div class="form-group">
               <MudText Typo="Typo.subtitle1"><b>Name (optional)</b></MudText>
               <MudText Typo="Typo.caption" Class="text-white-50 mb-2">The name of this sticker. If you enable the chat command, it can be specifically requested. Also required for channel point redemptions to target specific stickers OR you can even use the same name to target multiple stickers and a random one will be picked (i.e. "!sticker costume" to choose from a pool of costumes).</MudText>
               <MudTextField T="string" @bind-Value="CurrentlyEditedSticker.Name" />
            </div>
            <div class="form-group form-check">
               <MudCheckBox T="bool" @bind-Value="CurrentlyEditedSticker.Enabled" Label="Enabled" />
               <span id="uiNewStickerEnabled" class="gifbot-field-desc">When enabled, this sticker can be used! You can disable if you are creating a large batch for later use.</span>
            </div>
            <div class="form-group">
               <MudText Typo="Typo.subtitle1"><b>Sticker Visual</b></MudText>
               <MudText Typo="Typo.caption" Class="text-white-50 mb-2">The visual file displayed with this sticker.</MudText>
               <table>
                  <tr>
                     <td valign="top">
                        <MudTextField T="string" Disabled="true" @bind-Value="CurrentlyEditedSticker.Visual" />
                        @* TODO: Wire up file upload handler *@
<InputFile accept="image/gif,image/jpeg,image/png" style="width: 100%; background-color: #16162e" />
                        @if (mUploadStickerVisualProgress > 0)
                        {
                            <MudProgressLinear Value="@mUploadStickerVisualProgress" Style="margin-bottom: 20px; width: 100%" />
                        }
                        @if (!String.IsNullOrEmpty(mUploadStickerVisualErrorMessage))
                        {
                        <label class="text-danger">@mUploadStickerVisualErrorMessage</label>
                        }
                     </td>
                  </tr>
               </table>
            </div>
         </MudTabPanel>
         <MudTabPanel Text="Behavior Override">
            <div class="form-group form-check">
               <MudCheckBox T="bool" @bind-Value="CurrentlyEditedSticker.AllowRandomPlacement" Label="Allow Random Placement (Only use global Stickers behavior)" />
               <span id="uiAllowRandom" class="gifbot-field-desc">When enabled, the sticker will be able to be randomly placed per events configured from the Stickers global behaviors tab. If you want this sticker to only display for sticker-specific cheers/tips/donations then toggle this off and update the custom configurations to override the global behaviors!</span>
            </div>

            @if (!CurrentlyEditedSticker.AllowRandomPlacement)
            {
            <div class="form-group form-check">
               <MudCheckBox T="bool" @bind-Value="CurrentlyEditedSticker.IncludeBits" Label="Include Bits" />
               <span id="uiNewStickerIncludeCheers" class="gifbot-field-desc">When enabled, cheering will count as a sticker.</span>
            </div>

            @if (CurrentlyEditedSticker.IncludeBits)
               {
            <div class="form-group">
               <label for="uiNewStickerBitPointsLabel">Bits Amount:</label>
               <span id="uiNewStickerBitPointsLabel" class="gifbot-field-desc">The exact number of bits that need to be cheered to make this sticker appear.</span>
               <MudNumericField T="int" Min="0" Max="999999" @bind-Value="CurrentlyEditedSticker.BitAmount" />
            </div>
               }

            <div class="form-group form-check">
               <MudCheckBox T="bool" @bind-Value="CurrentlyEditedSticker.IncludeTips" Label="Include Streamlabs Tips" />
               <span id="uiNewStickerIncludeTips" class="gifbot-field-desc">When enabled, tipping via Streamlabs will create this sticker.</span>
            </div>

            @if (CurrentlyEditedSticker.IncludeTips)
               {
            <div class="form-group">
               <label for="uiNewStickerTipPointsLabel">Tip Amount:</label>
               <span id="uiNewStickerTipPointsLabel" class="gifbot-field-desc">The exact tip amount to make this sticker appear.</span>
               <MudNumericField T="double" Min="0" Max="999999" @bind-Value="CurrentlyEditedSticker.TipAmount" />
            </div>
               }

            <div class="form-group form-check">
               <MudCheckBox T="bool" @bind-Value="CurrentlyEditedSticker.IncludeTiltifyDonations" Label="Include Tiltify Donations" />
               <span id="uiNewStickerIncludeTiltify" class="gifbot-field-desc">When enabled, donating to charity via Tiltify will create a sticker.</span>
            </div>

            @if (CurrentlyEditedSticker.IncludeTiltifyDonations)
               {
            <div class="form-group">
               <label for="uiNewStickerDonationsPointsLabel">Donation Amount:</label>
               <span id="uiNewStickerDonationsPointsLabel" class="gifbot-field-desc">The exact donation amount to make this sticker appear.</span>
               <MudNumericField T="double" Min="0" Max="999999" @bind-Value="CurrentlyEditedSticker.TiltifyDonationAmount" />
            </div>
               }

            <div class="form-group form-check">
               <MudCheckBox T="bool" @bind-Value="CurrentlyEditedSticker.UseVisibilityTimeoutOverride" Label="Override Global Sticker Timeout" />
               <span id="uiNewStickerOverrideTimeout" class="gifbot-field-desc">When enabled, this sticker will use a different timeout than the global one configured in the behavior tab.</span>
            </div>

            @if (CurrentlyEditedSticker.UseVisibilityTimeoutOverride)
               {
            <div class="form-group">
               <label for="uiNumSecondsVisibleOverride"><b>Number of Seconds this Sticker is Visible:</b></label>
               <span id="uiNumSecondsVisibleOverride" class="gifbot-field-desc">The sticker will only remain visible for the number of seconds you specify below. If you do not want them to disappear, set this to 0.</span>
               <MudNumericField T="int" Min="0" Max="999999" @bind-Value="CurrentlyEditedSticker.NumSecondsStickerVisibleOverride" />
            </div>
               }
            }
         </MudTabPanel>
         <MudTabPanel Text="Dimensions and Placement">
            <div class="text-white-50 p-0">
               <p>
                  If your sticker image is too big, you can resize it using the placement control below. You can provide a placement override and use that as well, should you
                  want this sticker to always appear in the same location.
               </p>
            </div>
            <div class="form-group form-check">
               <MudCheckBox T="bool" @bind-Value="CurrentlyEditedSticker.UsePlacementOverride" Label="Always use the position below for this sticker." />
               <span id="uiNewStickerOverridePosition" class="gifbot-field-desc">When enabled, this sticker will always appear in the same location as illustrated on the control below:</span>
            </div>
            <div class="form-group">
               <label for="uiStickerLayer">Layer:</label>
               <span id="uiStickerLayer" class="gifbot-field-desc">The sticker can appear on a primary or secondary layer (browser source) that you can capture in your broadcaster software.</span>
               <MudRadioGroup @bind-Value="@CurrentlyEditedStickerLayer" T="int">
<MudRadio T="int" Value="@(0)">Primary</MudRadio>
                     <MudRadio T="int" Value="@(1)">Secondary</MudRadio>
</MudRadioGroup>
            </div>

            <div class="p-2 text-center">
               <PlacementComponent CanvasWidth="@mWorkingCanvasWidth"
                                   CanvasHeight="@mWorkingCanvasHeight"
                                   Width="@CurrentlyEditedSticker.Placement.Width"
                                   Height="@CurrentlyEditedSticker.Placement.Height"
                                   Top="@CurrentlyEditedSticker.Placement.Top"
                                   Left="@CurrentlyEditedSticker.Placement.Left"
                                   IsOutOfBounds="@CurrentlyEditedSticker.Placement.IsOutOfBounds"
                                   ShowCommitButton="false"
                                   IsDisplayTestMode="@mIsDisplayTestMode"
                                   DataEditType="@(global::GIFBot.Shared.AnimationEnums.UpdateVisualType.Sticker)"
                                   OnDisplayTestModeChanged="@(args => HandleDisplayTestModeChanged(args, CurrentlyEditedSticker))"
                                   OnNotifyDimensionsChanged="@(args => HandleNotifyDimensionsChanged(args, CurrentlyEditedSticker))" />
            </div>
         </MudTabPanel>
      </MudTabs>
   </DialogContent>
   <DialogActions>
      <MudButton OnClick="@HandleCancelStickerUpdate">Cancel</MudButton>
      <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@HandleConfirmStickerUpdate">Update!</MudButton>
   </DialogActions>
</MudDialog>

<EditForm Model="@mStickerData" OnSubmit="@OnSaveChanges">
   <div style="width: 100%">
      <div class="text-left p-3 rounded gifbot-form-panel" style="width: 100%">
         <div class="d-flex align-center gap-2 mb-3">
            <MudText Typo="Typo.subtitle1"><b>Quick Actions:</b></MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@ClearAllStickers">Clear All Stickers</MudButton>
         </div>
   <MudTabs @bind-ActivePanelIndex="@ActiveTabIndex" ApplyEffectsToContainer="true" Elevation="0" Rounded="true" PanelClass="pa-3">
      <MudTabPanel Text="Settings">
            <div class="p-0 m-0 rounded gifbot-section-panel">
               <div class="p-2">
               <p>
                  <b>Stickers</b> is a feature of GIFBot where you can have certain events place a sticker on the screen. Think of this as a
                  virtual way to torture yourself for your viewers' benefit. It's a great way to promote charitable events and to have viewers
                  feel like they are making an impact on your streams.
               </p>
               <p>
                  You don't have to just support random events though! An individual sticker can be placed for a specific amount of bits, tips,
                  or donations too! If you enable the command, you can even use that in a channel point reward. Hint: Have your viewers donate
                  to charity to put you in a virtual costume!
               </p>
               <div class="text-left p-3 rounded gifbot-section-panel">

                  <div class="form-group form-check">
                     <MudCheckBox T="bool" @bind-Value="mStickerData.Enabled" Label="Feature Enabled" />
                     <span id="uiEnabled" class="gifbot-field-desc">When enabled, Twitch events will be able to contribute to the stickers overlay.</span>
                  </div>

                  @if (mStickerData.Enabled)
                  {
                     <MudExpansionPanel Text="Chat Command" Expanded="true">
                        <div class="form-group form-check">
                           <MudCheckBox T="bool" @bind-Value="mStickerData.CanUseCommand" Label="Allow Chat Command Access" />
                           <span id="uiUseChatCommand" class="gifbot-field-desc">When enabled, the system can place stickers using the chat command. You can also use this command in a bot-only mode to have channel point rewards activating special stickers by name. Just put "!stickers [name of sticker]" in your reward title!</span>
                        </div>

                        @if (mStickerData.CanUseCommand)
                        {
                           <div class="form-group">
                              <label for="uiChatCommand">Chat Command:</label>
                              <span id="uiChatCommand" class="gifbot-field-desc">The command used to access this feature.</span>
                              <MudTextField T="string" @bind-Value="mStickerData.Command" />
                           </div>
                           <div class="form-group">
                              <label for="uiSecondsBetweenCommandUses">Command Cooldown:</label>
                              <span id="uiSecondsBetweenCommandUses" class="gifbot-field-desc">The number of seconds between command uses. Helps space out the zany. Does not affect placement from channel point redemptions.</span>
                              <DataAnnotationsValidator />
                              <ValidationSummary />
                              <MudNumericField T="int" Min="0" Max="999999" @bind-Value="mStickerData.CommandCooldownSeconds" />
                           </div>
                           <div class="form-group">
                              <label for="uiAccess"><b>Access Type:</b></label>
                              <span id="uiAccess" class="gifbot-field-desc">
                                 You can limit what kind of viewer has access to use this command. Your options are below. If you are making
                                 this command to be used from channel point rewards, it is recommended to flag it as Bot Only!
                              </span>
                              <MudRadioGroup @bind-Value="mAccessSelection" T="int">
<MudRadio T="int" Value="@(0)">Anyone</MudRadio>
                                    <MudRadio T="int" Value="@(2)">Subscriber</MudRadio>
                                    <MudRadio T="int" Value="@(3)">VIP</MudRadio>
                                    <MudRadio T="int" Value="@(4)">Moderator</MudRadio>
                                    <MudRadio T="int" Value="@(5)">User Group</MudRadio>
                                    <MudRadio T="int" Value="@(6)">Specific Viewer</MudRadio>
                                    <MudRadio T="int" Value="@(7)">Bot Only</MudRadio>
</MudRadioGroup>
                           </div>

                           @if (mStickerData.Access == global::GIFBot.Shared.AnimationEnums.AccessType.UserGroup)
                           {
                              <div class="form-group">
                                 <label for="uiUserGroup"><b>User Group:</b></label>
                                 <span id="uiUserGroup" class="gifbot-field-desc">Access is restricted to a user group. Which one?</span>

                                 <MudSelect T="string" Placeholder="Select User Group..." Style="width: 250px;"
 Value="@mUserGroupName" ValueChanged="@(args => HandleUserGroupSelected(args as string))" />
                              </div>
                           }
                           else if (mStickerData.Access == global::GIFBot.Shared.AnimationEnums.AccessType.SpecificViewer)
                           {
                              <div class="form-group">
                                 <label for="uiRestrictedToUser"><b>Specific Viewer:</b></label>
                                 <span id="uiRestrictedToUser" class="gifbot-field-desc">Access is restricted to a specific viewer. Which one?</span>
                                 <MudTextField T="string" @bind-Value="@mStickerData.RestrictedToUser" />
                              </div>
                              <div class="mt-2">
                                 <MudCheckBox T="bool" @bind-Value="mStickerData.RestrictedUserMustBeSub" Label="Viewer must be subscribed" />
                              </div>
                           }
                        }
                     </MudExpansionPanel>

                     <div class="form-group">
                        <label for="uiAudio"><b>Audio:</b></label>
                        <span id="uiAudio" class="gifbot-field-desc">The audio file played when a sticker appears.</span>
                        <table>
                           <tr>
                              <td valign="top">
                                 <MudTextField T="string" Disabled="true" @bind-Value="mStickerData.Audio" />
                                 @* TODO: Wire up file upload handler *@
<InputFile accept="audio/*" style="width: 100%; background-color: #16162e" />
                                 @if (mUploadAudioProgress > 0)
                                 {
                                     <MudProgressLinear Value="@mUploadAudioProgress" Style="margin-bottom: 20px; width: 100%" />
                                 }
                                 @if (!String.IsNullOrEmpty(mUploadAudioErrorMessage))
                                 {
                                    <label class="text-danger">@mUploadAudioErrorMessage</label>
                                 }
                              </td>
                              <td style="width: 30px; text-align: center; vertical-align: top"><MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Class="gifbot-neutral-btn" OnClick="@ClearAudioFile" Title="Clear Audio" /></td>
                           </tr>
                        </table>
                     </div>

                     @if (!String.IsNullOrEmpty(mStickerData.Audio))
                     {
                        <div class="form-group">
                           <label for="uiVolumeSlider" class="ml-2 mt-2"><b>Volume:</b></label>
                           <center><input type="range" class="slider" min="0" max="100" value="@mFormVolume" id="uiVolumeSlider" @onchange="@(args => OnVolumeChanged(args))"></center>
                           <p align="right">
                              @if (!String.IsNullOrEmpty(mStickerData.Audio))
                              {
                                 <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="p-1 mr-2 mb-2 text-center" Style="width: 200px" OnClick="@HandleTestAudioVolume">
                                    Test Audio File Volume
                                 </MudButton>
                              }
                           </p>
                        </div>
                     }

                     <div class="form-group">
                        <label for="uiNumSecondsVisible"><b>Number of Seconds a Sticker is Visible:</b></label>
                        <span id="uiNumSecondsVisible" class="gifbot-field-desc">The sticker will only remain visible for the number of seconds you specify below. If you do not want them to disappear, set this to 0.</span>
                        <MudNumericField T="int" Min="0" Max="999999" @bind-Value="mStickerData.NumSecondsStickerVisible" />
                     </div>

                     <div class="form-group">
                        <label for="uiMaxStickers"><b>Max Stickers:</b></label>
                        <span id="uiMaxStickers" class="gifbot-field-desc">The max number of visible stickers at any time. If exceeded, older stickers will be removed.</span>
                        <MudNumericField T="int" Min="1" Max="300" @bind-Value="mStickerData.MaxStickers" />
                     </div>

                     <MudExpansionPanel Text="Primary Layer Canvas Size" Expanded="true">
                        <p>
                           The canvas is the area that stickers will appear in. By default, this is 1920x1080, but you can size it however you like. When
                           you put the browser source in your broadcaster software, make sure that the size matches up!
                        </p>
                        <div class="form-group">
                           <label for="uiCanvasWidth"><b>Max Canvas Width:</b></label>
                           <span id="uiCanvasWidth" class="gifbot-field-desc">The max width of your overlay area where you want stickers to be visible.</span>
                           <MudNumericField T="int" Min="100" Max="999999" @bind-Value="mStickerData.CanvasWidth" />
                        </div>

                        <div class="form-group">
                           <label for="uiCanvasHeight"><b>Max Canvas Height:</b></label>
                           <span id="uiCanvasHeight" class="gifbot-field-desc">The max height of your overlay area where you want stickers to be visible.</span>
                           <MudNumericField T="int" Min="100" Max="999999" @bind-Value="mStickerData.CanvasHeight" />
                        </div>
                     </MudExpansionPanel>

                     <MudExpansionPanel Text="Secondary Layer Canvas Size" Expanded="true">
                        <p>
                           You can have a second layer where stickers can appear, with its own size! This allows you to have randomly generated stickers and more unique stickers appear on separate layers in OBS.
                        </p>
                        <div class="form-group">
                           <label for="uiSecondaryCanvasWidth"><b>Max Canvas Width:</b></label>
                           <span id="uiSecondaryCanvasWidth" class="gifbot-field-desc">The max width of your overlay area where you want stickers to be visible.</span>
                           <MudNumericField T="int" Min="100" Max="999999" @bind-Value="mStickerData.SecondaryCanvasWidth" />
                        </div>

                        <div class="form-group">
                           <label for="uiSecondaryCanvasHeight"><b>Max Canvas Height:</b></label>
                           <span id="uiSecondaryCanvasHeight" class="gifbot-field-desc">The max height of your overlay area where you want stickers to be visible.</span>
                           <MudNumericField T="int" Min="100" Max="999999" @bind-Value="mStickerData.SecondaryCanvasHeight" />
                        </div>
                     </MudExpansionPanel>
                  }
               </div>
            </div>
         </div>
      </MudTabPanel>

      <MudTabPanel Text="Randomized Stickers Behavior">
            <div class="p-0 m-0 rounded gifbot-section-panel">
               <div class="p-2">
                  <p>
                     Stickers can be randomly placed or deliberately placed by name. For stickers with random placement enabled, you can have one of those stickers
                     appear when the following events happen (as long as they meet your thresholds!):
                  </p>

                  <div class="form-group form-check">
                     <MudCheckBox T="bool" @bind-Value="mStickerData.IncludeBits" Label="Include Bits" />
                     <span id="uiIncludeCheers" class="gifbot-field-desc">When enabled, cheering will count as a sticker.</span>
                  </div>

                  @if (mStickerData.IncludeBits)
                  {
                     <div class="form-group">
                        <label for="uiBitPointsLabel">Bits Minimum:</label>
                        <span id="uiBitPointsLabel" class="gifbot-field-desc">The minimum number of bits that need to be cheered to make a sticker. Must be non-zero to work.</span>
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <MudNumericField T="int" Min="1" Max="999999" @bind-Value="mStickerData.BitMinimum" />
                     </div>
                  }

                  <div class="form-group form-check">
                     <MudCheckBox T="bool" @bind-Value="mStickerData.IncludeTips" Label="Include Streamlabs Tips" />
                     <span id="uiIncludeTips" class="gifbot-field-desc">When enabled, tipping via Streamlabs will create a sticker.</span>
                  </div>

                  @if (mStickerData.IncludeTips)
                  {
                     <div class="form-group">
                        <label for="uiTipPointsLabel">Tip Minimum:</label>
                        <span id="uiTipPointsLabel" class="gifbot-field-desc">The minimum tip amount to make a sticker.</span>
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <MudNumericField T="double" Min="0" Max="999999" @bind-Value="mStickerData.TipMinimum" />
                     </div>
                  }

                  <div class="form-group form-check">
                     <MudCheckBox T="bool" @bind-Value="mStickerData.IncludeTiltifyDonations" Label="Include Tiltify Donations" />
                     <span id="uiIncludeTiltify" class="gifbot-field-desc">When enabled, donating to charity via Tiltify will create a sticker.</span>
                  </div>

                  @if (mStickerData.IncludeTiltifyDonations)
                  {
                     <div class="form-group">
                        <label for="uiDonationsPointsLabel">Donation Minimum:</label>
                        <span id="uiDonationsPointsLabel" class="gifbot-field-desc">The minimum donation amount to make a sticker.</span>
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <MudNumericField T="double" Min="0" Max="999999" @bind-Value="mStickerData.TiltifyDonationMinimum" />
                     </div>
                  }

                  <div class="form-group form-check">
                     <MudCheckBox T="bool" @bind-Value="mStickerData.IncludeSubs" Label="Include Subscriptions" />
                     <span id="uiIncludeSubs" class="gifbot-field-desc">When enabled, subscriptions and resubscriptions create stickers.</span>
                  </div>

                  <div class="form-group form-check">
                     <MudCheckBox T="bool" @bind-Value="mStickerData.IncludeGiftSubs" Label="Include Gifted Subscriptions" />
                     <span id="uiIncludeGiftSubs" class="gifbot-field-desc">When enabled, gifted subscriptions create stickers.</span>
                  </div>

                  @if (mStickerData.IncludeGiftSubs)
                  {
                     <div class="form-group">
                        <label for="uiGiftSubPointsLabel">Gift Sub Count Minimum:</label>
                        <span id="uiGiftSubPointsLabel" class="gifbot-field-desc">The minimum number of gifted subscriptions to make a sticker.</span>
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <MudNumericField T="int" Min="0" Max="999999" @bind-Value="mStickerData.GiftSubMinimum" />
                     </div>
                  }

                  <div class="form-group form-check">
                     <MudCheckBox T="bool" @bind-Value="mStickerData.IncludeChannelPoints" Label="Include Channel Points" />
                     <span id="uiIncludeChannelPoints" class="gifbot-field-desc">When enabled, channel point redemptions will create stickers.</span>
                  </div>

                  @if (mStickerData.IncludeChannelPoints)
                  {
                     <div class="form-group">
                        <label for="uiNumChannelPoints"><b>Channel Point Minimum</b></label>
                        <span id="uiNumChannelPoints" class="gifbot-field-desc">The minimum number of points that must be spent in order to create a sticker.</span>
                        <MudNumericField T="int" Min="0" Max="999999" @bind-Value="mStickerData.ChannelPointsMinimum" />
                     </div>
                  }

                  <div class="form-group form-check">
                     <MudCheckBox T="bool" @bind-Value="mStickerData.IncludeFollows" Label="Include Follows" />
                     <span id="uiIncludeFollows" class="gifbot-field-desc">When enabled, follows will create stickers.</span>
                  </div>

                  <div class="form-group form-check">
                     <MudCheckBox T="bool" @bind-Value="mStickerData.IncludeRaids" Label="Include Raids" />
                     <span id="uiIncludeRaids" class="gifbot-field-desc">When enabled, raids will create stickers.</span>
                  </div>
               </div>
            </div>
      </MudTabPanel>

      <MudTabPanel Text="Sticker Images">
         @* MudBlazor: Use MudTooltip wrapping individual elements instead *@

         <div class="p-0 m-0 rounded gifbot-section-panel">
            <div class="p-2">
               <div class="text-white-50 p-0">
                  <p>
                     There are two kinds of stickers - those that are placed randomly by the system based on events you configured in the Behavior tab or those stickers which have very specific, individual requirements. The stickers with trigger requirements are largely used
                     for fun things like costumes or stickers you only want to show up for very SPECIFIC requirements. Some examples:
                     <ul>
                        <li>Channel point reward to put a wizard hat over your head.</li>
                        <li>Charitable donation to cover your face with a pug mask.</li>
                        <li>Bits to give you a mustache.</li>
                        <li>etc, etc, etc</li>
                     </ul>
                  </p>
               </div>
               <div class="form-group">
                  <MudTabs @bind-ActivePanelIndex="@ActiveStickerTabIndex" ApplyEffectsToContainer="true" Elevation="0" Rounded="true" PanelClass="pa-3">
                     <MudTabPanel Text="Stickers">
                        <div class="d-flex justify-end mb-2">
                           <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@HandleAddCategoryRequest">Add Category</MudButton>
                        </div>
                        <MudDataGrid T="StickerTreeListItem" Items="@mStickerTreeListData" Filterable="true" SortMode="SortMode.Single" Groupable="false">
                           <ToolBarContent>
                              <MudTextField T="string" Placeholder="Search..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                              @if (mSelectedTreeItems.Where(t => t.Type == StickerTreeListItem.ItemType.Entry).Any())
                              {
                                 <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@HandleMoveSelectedRequest">Move</MudButton>
                                 <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@HandleDeleteSelectedRequest">Delete</MudButton>
                                 <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@HandleEnableSelectedRequest">Enable</MudButton>
                                 <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@HandleDisableSelectedRequest">Disable</MudButton>
                              }
                           </ToolBarContent>
                           <Columns>
                              <SelectColumn T="StickerTreeListItem" />
                              <TemplateColumn Title="Name" Filterable="true" >
<CellTemplate Context="stickercontext">
                                    @{ var sticker = stickercontext.Item; }
                                    @if (sticker.Type == StickerTreeListItem.ItemType.Category)
                                    {
                                       <strong>@sticker.Name</strong>
                                    }
                                    else
                                    {
                                       @sticker.Name
                                    }
                                 </CellTemplate>
                              </TemplateColumn>
                              <TemplateColumn Title="Enabled" Filterable="false">
<CellTemplate Context="stickercontext">
                                    @{
                                       string output = "No";
                                       var sticker = stickercontext.Item;
                                       if (sticker.Enabled)
                                       {
                                          output = "Yes";
                                       }
                                    }
                                    @if (sticker.Type == StickerTreeListItem.ItemType.Entry)
                                    {
                                       <center>@output</center>
                                    }
                                 </CellTemplate>
                              </TemplateColumn>
                              <TemplateColumn Filterable="false">
<CellTemplate Context="stickercontext">
                                    @{ var sticker = stickercontext.Item; }
                                    @if (sticker.Type == StickerTreeListItem.ItemType.Entry)
                                    {
                                       <img src="@($"media/{sticker.Visual}?{System.DateTimeOffset.UtcNow.ToUnixTimeSeconds()}")" style="height: 50px; width: auto" />
                                    }
                                 </CellTemplate>
                              </TemplateColumn>
                              <PropertyColumn T="StickerTreeListItem" TProperty="string" Property="@(x => x.Visual)" Title="Visual Filename" Filterable="true" />
                              <TemplateColumn>
<CellTemplate Context="stickercontext">
                                    @{
                                        var sticker = stickercontext.Item;
                                    }
                                    @if (sticker.Type == StickerTreeListItem.ItemType.Category)
                                      {
                                         <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Class="gifbot-neutral-btn" OnClick="@(() => HandleAddStickerRequest(sticker.Id))" Title="Add Sticker" />
                                         <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="gifbot-neutral-btn" OnClick="@(() => HandleEditStickerRequest(sticker))" Title="Rename Category" />
                                         <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="gifbot-neutral-btn" OnClick="@(() => HandleDeleteSticker(sticker))" Title="Delete Category" />
                                      }
                                      else
                                      {
                                         <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="gifbot-neutral-btn" OnClick="@(() => HandleEditStickerRequest(sticker))" Title="Edit Sticker" />
                                         <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="gifbot-neutral-btn" OnClick="@(() => HandleDeleteSticker(sticker))" Title="Delete Sticker" />
                                         <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Class="gifbot-neutral-btn" OnClick="@(() => HandlePlaceSticker(sticker))" Title="Place Sticker" />
                                      }
                                 </CellTemplate>                                 
                              </TemplateColumn>
                           </Columns>
                        </MudDataGrid>
                     </MudTabPanel>
                     @if (mStickerData.Categories.Any())
                     {
                        <MudTabPanel Text="Add New Sticker...">
                           <div class="form-group">
                              <label for="uiTempStickerName"><b>Name (optional):</b></label>
                              <span id="uiTempStickerName" class="gifbot-field-desc">The name of this sticker. If you enable the chat command, it can be specifically requested. Also required for channel point redemptions to target specific stickers OR you can even use the same name to target multiple stickers and a random one will be picked (i.e. "!sticker costume" to choose from a pool of costumes).</span>
                              <MudTextField T="string" @bind-Value="mTempStickerToAdd.Name" />
                           </div>
                           <div class="form-group">
                              <label for="uiTempStickerCategory">Select the new category from the list below:</label>
                              <span id="uiTempStickerCategory" class="gifbot-field-desc">Once moved, the animation data will be immediately saved.</span>
                              <MudSelect T="Guid" Placeholder="Select Category..." @bind-Value="@mTempStickerCategoryId">
                                  @if (mStickerData?.Categories != null)
                                  {
                                      @foreach (var cat in mStickerData.Categories)
                                      {
                                          <MudSelectItem T="Guid" Value="@cat.Id">@cat.Name</MudSelectItem>
                                      }
                                  }
                              </MudSelect>
                           </div>
                           <div class="form-group">
                              <label for="uiStickerVisual"><b>Sticker Visual:</b></label>
                              <span id="uiStickerVisual" class="gifbot-field-desc">The visual file displayed with this sticker.</span>
                              <table>
                                 <tr>
                                    <td valign="top">
                                       <MudTextField T="string" Disabled="true" @bind-Value="mTempStickerToAdd.Visual" />
                                       @* TODO: Wire up file upload handler *@
<InputFile accept="image/gif,image/jpeg,image/png" style="width: 100%; background-color: #16162e" />
                                       @if (mUploadStickerVisualProgress > 0)
                                       {
                                           <MudProgressLinear Value="@mUploadStickerVisualProgress" Style="margin-bottom: 20px; width: 100%" />
                                       }
                                       @if (!String.IsNullOrEmpty(mUploadStickerVisualErrorMessage))
                                       {
                                          <label class="text-danger">@mUploadStickerVisualErrorMessage</label>
                                       }
                                    </td>
                                 </tr>
                              </table>
                           </div>
                           <div class="d-flex justify-end pa-3">
                              <MudButton Variant="Variant.Filled" Class="gifbot-action-btn gifbot-secondary-btn p-1" OnClick="@HandleCancelNewSticker">Cancel</MudButton>
                              <MudButton Variant="Variant.Filled" Class="gifbot-action-btn gifbot-secondary-btn p-1" OnClick="@HandleAddNewSticker">Add New Sticker</MudButton>
                           </div>
                        </MudTabPanel>
                     }
                  </MudTabs>
               </div>
            </div>
         </div>
      </MudTabPanel>

      <MudTabPanel Text="BrowserSource URL">
         <div class="p-0 m-0 rounded gifbot-section-panel">
            <div class="p-2">
               <p class="text-white-50">
                  To display the stickers in your broadcaster software, copy these URLs and use them as the input for new Browser Source elements.
                  Make sure that the size of your browser source matches the working canvas size that you specified in the sticker settings!
               </p>
               <p class="text-white-50">
                  Note: If you set this browser source to refresh when you switch scenes, the stickers will flicker since it will rebuild as if you had refreshed in Chrome.
               </p>
               <div class="mb-4">
                  <label><b>Primary Stickers Layer:</b></label>
                  <div class="d-flex align-center mt-1" style="max-width: 700px">
                     <MudTextField T="string" Style="flex: 1" ReadOnly="true" @bind-Value="mURL" />
                     <MudButton Variant="Variant.Filled" Class="gifbot-action-btn p-1 ml-3" OnClick="@(() => HandleCopyUrl(mURL))">Copy to Clipboard</MudButton>
                  </div>
               </div>
               <div class="mb-4">
                  <label><b>Secondary Stickers Layer:</b></label>
                  <div class="d-flex align-center mt-1" style="max-width: 700px">
                     <MudTextField T="string" Style="flex: 1" ReadOnly="true" @bind-Value="mSecondaryURL" />
                     <MudButton Variant="Variant.Filled" Class="gifbot-action-btn p-1 ml-3" OnClick="@(() => HandleCopyUrl(mSecondaryURL))">Copy to Clipboard</MudButton>
                  </div>
               </div>
            </div>
         </div>
      </MudTabPanel>
   </MudTabs>

         <div class="d-flex justify-end pa-3 gap-4">
         <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@OnCancel">Cancel</MudButton>
         <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit">Save Changes</MudButton>
      </div>
      </div>
   </div>
</EditForm>
