@page "/setup/"
@using Microsoft.AspNetCore.SignalR.Client
@using global::GIFBot.Server.Components.Pages.Models
@using global::GIFBot.Server.Components.Utility
@using global::GIFBot.Shared
@using Microsoft.AspNetCore.Http.Connections
@inject NavigationManager NavigationManager
@inject global::GIFBot.Server.Components.Utility.ClientAppData ClientAppData
@inject HttpClient Http

@layout NoNavMenuLayout

@if (mBotSettings != null && mBotSettings.CurrentSetupStep == SetupStep.Welcome)
{
   <div class="pa-1 my-1 gifbot-page-header">
      <MudText Typo="Typo.h4"><span class="oi oi-cog" aria-hidden="true"></span> Bot Setup (Step 1 of 4): Welcome!</MudText>
   </div>

   <div class="d-flex justify-center">
      <div class="text-left p-3 rounded gifbot-form-panel" style="max-width: 700px; width: 100%">
         <p>
            Welcome to GIFBot! This wizard will guide you through the setup process in authenticating your bot and streamer accounts with Twitch.
            It is recommended that you setup a second Twitch account to use as your bot. If you already have a chat bot account, you may use that
            account for GIFBot as well.
         </p>
         <p>
            <b>Disclaimer:</b> This bot is developed by fiercekittenz as a side-project. She is a full-time engineer with a family and a part-time streaming
            career. Please be understanding if there are issues on which you need to seek support.
         </p>
         <div class="d-flex justify-end pa-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" @onclick="@HandleStartSetup">Let's Go!</MudButton>
         </div>
      </div>
   </div>
}
else if (mBotSettings != null && mBotSettings.CurrentSetupStep == SetupStep.BotOauth)
{
   <div class="pa-1 my-1 gifbot-page-header">
      <MudText Typo="Typo.h4"><span class="oi oi-cog" aria-hidden="true"></span> Bot Setup (Step 2 of 4): Bot Account Authentication!</MudText>
   </div>

   <div class="d-flex justify-center">
      <div class="text-left p-3 rounded gifbot-form-panel" style="max-width: 700px; width: 100%">
         <p class="text-left">
            Let's get you authenticated with Twitch! The authentication button below will take you to Twitch for authentication and bring you
            right back here! When you are on the Twitch site, please make sure to log into the <b><i>bot's account</i></b>.
         </p>
         <p class="text-left">
            Please know that this bot stores your authentication token to your computer. It will not be shared elsewhere
            and is private for your eyes only. Click on the button below to authenticate when you are ready:
         </p>
         @if (!String.IsNullOrEmpty(mErrValue) && mErrValue.Equals("BotInvalid"))
         {
            <p class="text-left">
               <MudText Color="Color.Error">
                  <b>The bot account did not authenticate with Twitch. Please try again with a valid account.</b>
               </MudText>
            </p>
         }
         <div class="d-flex justify-center pa-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" @onclick="@HandleSubmitTwitchBotAuth">Authenticate BOT Account</MudButton>
         </div>
      </div>
   </div>
}
else if (mBotSettings != null && mBotSettings.CurrentSetupStep == SetupStep.StreamerOauth)
{
   <div class="pa-1 my-1 gifbot-page-header">
      <MudText Typo="Typo.h4"><span class="oi oi-cog" aria-hidden="true"></span> Bot Setup (Step 3 of 4): Streamer Account Authentication</MudText>
   </div>

   <div class="d-flex justify-center">
      <div class="text-left p-3 rounded gifbot-form-panel" style="max-width: 700px; width: 100%">
         <p class="text-left">
            To have your bot join the correct channel as well as receive <MudText Color="Color.Success">host alerts</MudText>, <MudText Color="Color.Success">raid alerts</MudText>, <MudText Color="Color.Success">channel point redemption</MudText>, and <MudText Color="Color.Success">hype train progression</MudText> notices,
            you will need to authenticate with Twitch as the streamer as well.
         </p>
         @if (!String.IsNullOrEmpty(mErrValue) && mErrValue.Equals("StreamerInvalid"))
         {
            <p class="text-left">
               <MudText Color="Color.Error">
                  <b>The streamer's account did not authenticate with Twitch. Please try again with a valid account.</b>
               </MudText>
            </p>
         }
         <div class="d-flex justify-end pa-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" @onclick="@HandleSubmitTwitchStreamerAuth">Authenticate Streamer's Account</MudButton>
         </div>
      </div>
   </div>
}
else if (mBotSettings != null && mBotSettings.CurrentSetupStep == SetupStep.Finished)
{
   <div class="pa-1 my-1 gifbot-page-header">
      <MudText Typo="Typo.h4"><span class="oi oi-cog" aria-hidden="true"></span> Bot Setup (Step 4 of 4): Complete!</MudText>
   </div>

   <div class="d-flex justify-center">
      <div class="text-left p-3 rounded gifbot-form-panel" style="max-width: 700px; width: 100%">
         <p>
            <MudText Color="Color.Success"><b>You have successfully completed the initial bot setup!</b></MudText>
         </p>
         <ul>
            <li><b>Bot Name:</b> @(mBotSettings.BotName)</li>
            <li><b>Channel Name:</b> @(mBotSettings.ChannelName)</li>
         </ul>
         <p>
            Now you can continue to the <b>Bot Settings</b> to configure additional preferences <i>or</i> you can hop right into adding your first animation!
            Choose your destiny and enjoy the bot!
         </p>
         <div class="d-flex justify-center gap-2 pa-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" @onclick="@HandleFinishSettings">Go to Settings</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" @onclick="@HandleAddAnimations">Add Animations!</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" @onclick="@HandleFinishDashboard">Go to Dashboard</MudButton>
         </div>
      </div>
   </div>
}
else
{
   <div class="pa-1 my-1 gifbot-page-header">
      <MudText Typo="Typo.h4"><span class="oi oi-cog" aria-hidden="true"></span> Bot Setup: Error</MudText>
   </div>

   <div class="d-flex justify-center">
      <div style="max-width: 700px; width: 100%">
         <p>
            This isn't where I expected you to show up. Are you lost?
         </p>
      </div>
   </div>
}