@page "/animationseditor/"
@page "/animationseditor/{anim}"
@using Microsoft.AspNetCore.SignalR.Client
@using global::GIFBot.Shared
@using Microsoft.AspNetCore.Components
@using global::GIFBot.Server.Components.UI
@using global::GIFBot.Shared.Models.Animation
@using Newtonsoft.Json
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject HttpClient Http

<div class="pa-1 my-1 gifbot-page-header">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.PlayCircle" />
        <MudText Typo="Typo.h4">Animations</MudText>
    </MudStack>
</div>

<!-- Delete Category Confirmation Window -->
<MudDialog @bind-Visible="@mIsDeleteCategoryConfirmationVisible">
    <TitleContent>
        <MudText Typo="Typo.h6">Delete Category</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle1"><b>Confirm Deletion</b></MudText>
        <MudText Class="mt-2">Are you sure you want to delete the '<b>@(mTempCategory?.Title)</b>' category? If you have any animations in it, it will not succeed.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@HandleCancelCategoryDeletion">Cancel</MudButton>
        <MudButton Color="Color.Error" OnClick="@HandleConfirmCategoryDeletion">Delete</MudButton>
    </DialogActions>
</MudDialog>

<!-- Delete Animation(s) Confirmation Window -->
<MudDialog @bind-Visible="@mIsDeleteConfirmationVisible">
    <TitleContent>
        <MudText Typo="Typo.h6">Delete Animation</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle1"><b>Confirm Deletion</b></MudText>
        <MudText Class="mt-2">Are you sure you want to delete the selected animation(s)? This action cannot be undone.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@HandleCancelDeletion">Cancel</MudButton>
        <MudButton Color="Color.Error" OnClick="@HandleConfirmDeletion">Delete</MudButton>
    </DialogActions>
</MudDialog>

<!-- Move Categories Window -->
<MudDialog @bind-Visible="@mIsMoveCategoryDialogVisible">
    <TitleContent>
        <MudText Typo="Typo.h6">Move Animations</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle1"><b>Target Category</b></MudText>
        <MudText Typo="Typo.caption" Class="text-white-50 mb-2">Select the category to move the selected animation(s) into. Data will be saved immediately.</MudText>
        <MudSelect T="string" Placeholder="Select Category..." @bind-Value="@mSelectedMoveCategory">
            @foreach (var cat in mAnimationTreeData.Where(a => a.Tier == AnimationTreeTier.Category))
            {
                <MudSelectItem T="string" Value="@cat.Id.ToString()">@cat.Title</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@HandleCancelMove">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="@HandleConfirmMove">Move</MudButton>
    </DialogActions>
</MudDialog>

<!-- Add New Category Window -->
<MudDialog @bind-Visible="@mIsCreateCategoryDialogVisible">
    <TitleContent>
        <MudText Typo="Typo.h6">Add New Category</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle1"><b>Category Name</b></MudText>
        <MudText Typo="Typo.caption" Class="text-white-50 mb-2">Enter a unique name for the new animation category.</MudText>
        <MudTextField T="string" @bind-Value="mTempCategory.Title" Placeholder="Enter category name..." />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@HandleCancelAddCategory">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="@HandleConfirmAddCategory">Add</MudButton>
    </DialogActions>
</MudDialog>

<!-- Edit Category Window -->
<MudDialog @bind-Visible="@mIsEditCategoryDialogVisible">
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Category</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle1"><b>Category Name</b></MudText>
        <MudText Typo="Typo.caption" Class="text-white-50 mb-2">Update the name of this animation category.</MudText>
        <MudTextField T="string" @bind-Value="mTempCategory.Title" Placeholder="Enter category name..." />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@HandleCancelEditCategory">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="@HandleConfirmEditCategory">Update</MudButton>
    </DialogActions>
</MudDialog>

<!-- Add New Animation to Category Window -->
<MudDialog @bind-Visible="@mIsAddAnimationToCategoryDialogVisible">
    <TitleContent>
        <MudText Typo="Typo.h6">Add New Animation</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle1"><b>Name or Command</b></MudText>
        <MudText Typo="Typo.caption" Class="text-white-50 mb-2">Enter the name or command for the new animation. Include '!' for chat commands.</MudText>
        <MudTextField T="string" @bind-Value="mTempAnimationCommand" Placeholder="Enter animation name or !command..." />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@HandleCancelAddAnimationToCategory">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="@HandleConfirmAddAnimationToCategory">Add</MudButton>
    </DialogActions>
</MudDialog>

<!-- Main Layout for the Animations Editor -->
<div style="width: 100%">
    <div class="text-left p-3 rounded gifbot-form-panel" style="width: 100%">
        <MudTabs @bind-ActivePanelIndex="@ActiveTabIndex" ApplyEffectsToContainer="true" Elevation="0" Rounded="true" PanelClass="pa-3">
            <MudTabPanel Text="Animations">
                <div class="p-0 m-0 rounded gifbot-section-panel">
                    <div class="p-2">
                        <MudDataGrid T="AnimationTreeItem" Items="@mAnimationTreeData" Filterable="true" SortMode="SortMode.Single" Groupable="false"
                                         @ref="@AnimationTreeListRef">
                            <ToolBarContent>
                                <MudTextField T="string" Placeholder="Search..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.UnfoldMore" OnClick="@HandleExpandAllRequest">Expand All</MudButton>
                                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.UnfoldLess" OnClick="@HandleCollapseAllRequest">Collapse All</MudButton>
                                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.CreateNewFolder" OnClick="@HandleAddCategoryRequest">Add Category</MudButton>
                                @if (mSelectedTreeItems.Where(t => t.Tier == AnimationTreeTier.Animation).Any())
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@HandleMoveSelectedRequest">Move</MudButton>
                                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@HandleDeleteSelectedRequest">Delete</MudButton>
                                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@HandleEnableSelectedRequest">Enable</MudButton>
                                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@HandleDisableSelectedRequest">Disable</MudButton>
                                }
                            </ToolBarContent>
                            <Columns>
                                <SelectColumn T="AnimationTreeItem" />
                                <TemplateColumn Title="Name" Filterable="true">
<CellTemplate Context="itemcontext">
                                        @{
                                            var item = itemcontext.Item;
                                        }
                                        @if (item.Tier == AnimationTreeTier.Category)
                                        {
                                            <strong>@item.Title</strong>
                                        }
                                        else
                                        {
                                            <u><a href="/animationseditor/editanimation/@item.ParentTreeId/@item.Id">@item.Title</a></u>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Enabled" Filterable="false">
<CellTemplate Context="itemcontext">
                                        @{
                                            string output = "Yes";
                                            var item = itemcontext.Item;
                                            if (item.Disabled)
                                            {
                                                output = "No";
                                            }
                                        }
                                        @if (item.Tier == AnimationTreeTier.Animation)
                                        {
                                            @output
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn>
<CellTemplate Context="itemcontext">
                                        @{
                                            var item = itemcontext.Item;
                                        }
                                        @if (item.Tier == AnimationTreeTier.Category)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Class="gifbot-neutral-btn" OnClick="@(() => HandleAddAnimationRequest(item.Id))" Title="Add Animation" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="gifbot-neutral-btn" OnClick="@(() => HandleEditCategoryRequest(item))" Title="Rename Category" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="gifbot-neutral-btn" OnClick="@(() => HandleDeleteCategory(item))" Title="Delete Category" />
                                        }
                                        else
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="gifbot-neutral-btn" OnClick="@(() => HandleEditAnimationRequest(item))" Title="Edit Animation" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="gifbot-neutral-btn" OnClick="@(() => HandleDeleteAnimation(item))" Title="Delete Animation" />
                                            <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Class="gifbot-neutral-btn" OnClick="@(() => HandlePlayAnimation(item))" Title="Play Animation" />
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                        </MudDataGrid>
                    </div>
                </div>
            </MudTabPanel>
        </MudTabs>
    </div>
</div>
