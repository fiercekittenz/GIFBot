@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h5" Class="ml-3">GIFBot</MudText>
        <MudSpacer />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
        <MudSpacer />
        <div class="pa-4 d-flex justify-center">
            <a href="https://www.gifbot.io/" target="_blank">
                <img src="gifbot_logo.png" width="120" />
            </a>
        </div>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private static bool _isDarkMode = true;

    private static MudTheme _theme = new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#5d3e9c",
            Secondary = "#7e57c2",
            AppbarBackground = "#5d3e9c",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#7e57c2",
            Secondary = "#b39ddb",
            Tertiary = "#ce93d8",
            Info = "#4fc3f7",
            Success = "#66bb6a",
            Warning = "#ffa726",
            Error = "#ef5350",
            Dark = "#1a1a2e",
            Surface = "#22223a",
            Background = "#0d0d1a",
            BackgroundGray = "#161628",
            AppbarBackground = "#1a1a2e",
            AppbarText = "#ffffffde",
            DrawerBackground = "#1a1a2e",
            DrawerText = "#ffffffde",
            DrawerIcon = "#b39ddb",
            TextPrimary = "#ffffffde",
            TextSecondary = "#ffffffa0",
            TextDisabled = "#ffffff4d",
            ActionDefault = "#b39ddb",
            ActionDisabled = "#ffffff42",
            ActionDisabledBackground = "#ffffff1f",
            LinesDefault = "#ffffff2e",
            LinesInputs = "#ffffff80",
            TableLines = "#ffffff1f",
            TableStriped = "#ffffff0a",
            Divider = "#ffffff1f",
            DividerLight = "#ffffff0f",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Noto Sans", "Helvetica", "Arial", "sans-serif" }
            }
        }
    };
}
