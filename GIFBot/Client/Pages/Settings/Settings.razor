            ("RemoveUserFromGroup", mSelectedUserGroup.Id, user);
         if (result)
         {
            Snackbar.Add($"Success - {user} was removed from the group!", Severity.Success);
            await UpdateClientBotSettingsData();
         }
         else
         {
            Snackbar.Add($"Error - {user} couldn't be found!", Severity.Error);
